{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

<section class="kw-scope kw-section kw-featproj{% if section.settings.image_position == 'right' %} kw-featproj--reverse{% endif %}" id="kw-featproj-{{ section.id }}">
  <div class="kw-wrap kw-featproj__inner">
    <div class="kw-featproj__media kw-reveal-scale">
      <div class="kw-featproj__frame">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 800px) 100vw, 50vw"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {% elsif section.settings.image_asset != blank %}
        <img src="{{ section.settings.image_asset | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {% endif %}
      {% if section.settings.badge != blank %}
        <span class="kw-featproj__badge">{{ section.settings.badge }}</span>
      {% endif %}
      </div>

      {% if section.settings.image_2 != blank or section.settings.image_2_asset != blank %}
        <div class="kw-featproj__polaroid" style="--r: {{ section.settings.image_2_rotation }}deg">
          {% if section.settings.image_2 != blank %}
            <img
              src="{{ section.settings.image_2 | image_url: width: 700 }}"
              alt="{{ section.settings.image_2_caption | escape }}"
              loading="lazy"
              width="{{ section.settings.image_2.width }}"
              height="{{ section.settings.image_2.height }}"
            >
          {% elsif section.settings.image_2_asset != blank %}
            <img src="{{ section.settings.image_2_asset | asset_url }}" alt="{{ section.settings.image_2_caption | escape }}" loading="lazy">
          {% endif %}
          {% if section.settings.image_2_caption != blank %}
            <span>{{ section.settings.image_2_caption }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <div class="kw-featproj__content kw-reveal">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h3>{{ section.settings.heading }}</h3>
      <div class="kw-featproj__body">{{ section.settings.body }}</div>
      {% if section.settings.quote != blank %}
        <blockquote class="kw-featproj__quote">
          &ldquo;{{ section.settings.quote }}&rdquo;
          {% if section.settings.quote_author != blank %}
            <cite>{{ section.settings.quote_author }}</cite>
          {% endif %}
        </blockquote>
      {% endif %}
      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link_url }}" class="kw-btn kw-btn--teal">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #kw-featproj-{{ section.id }} {
    padding-block: clamp(40px, 6vw, 84px);
  }

  #kw-featproj-{{ section.id }} .kw-featproj__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  #kw-featproj-{{ section.id }}.kw-featproj--reverse .kw-featproj__media {
    order: 2;
  }

  #kw-featproj-{{ section.id }} .kw-featproj__media {
    position: relative;
  }

  /* The clip lives on the frame, not the media wrapper — otherwise it slices
     the polaroid, which is meant to overhang the photo's bottom-right corner. */
  #kw-featproj-{{ section.id }} .kw-featproj__frame {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  #kw-featproj-{{ section.id }} .kw-featproj__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #kw-featproj-{{ section.id }} .kw-featproj__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--kw-gold);
    color: var(--kw-bg);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.5em 0.9em;
    border-radius: 100px;
  }

  #kw-featproj-{{ section.id }} .kw-featproj__polaroid {
    position: absolute;
    z-index: 2;
    bottom: -26px;
    right: -28px;
    width: 38%;
    background: var(--kw-bg-raised);
    border: 1px solid var(--kw-line);
    border-radius: 10px;
    padding: 8px 8px 26px;
    transform: rotate(var(--r));
    box-shadow: 0 18px 40px -20px #000000cc;
  }

  #kw-featproj-{{ section.id }} .kw-featproj__polaroid img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    height: auto;
  }

  #kw-featproj-{{ section.id }} .kw-featproj__polaroid span {
    position: absolute;
    bottom: 8px;
    left: 10px;
    right: 10px;
    font-family: var(--kw-display);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    /* Was var(--kw-bg) — near-black text on a near-black card, i.e. invisible. */
    color: var(--kw-fg-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #kw-featproj-{{ section.id }} h3 {
    font-family: var(--kw-display);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    margin-block: 0.4em 0.6em;
  }

  #kw-featproj-{{ section.id }} .kw-featproj__body {
    color: var(--kw-fg-dim);
    max-width: 44ch;
    margin-bottom: 1.2rem;
    line-height: 1.6;
  }

  #kw-featproj-{{ section.id }} .kw-featproj__quote {
    margin: 0 0 1.6rem;
    padding-left: 1.2rem;
    border-left: 2px solid var(--kw-teal);
    font-style: italic;
    color: var(--kw-fg);
    max-width: 42ch;
  }

  #kw-featproj-{{ section.id }} .kw-featproj__quote cite {
    display: block;
    margin-top: 0.5em;
    font-style: normal;
    font-size: 0.8rem;
    color: var(--kw-fg-dim);
  }

  @media (max-width: 800px) {
    #kw-featproj-{{ section.id }} .kw-featproj__inner {
      grid-template-columns: 1fr;
    }
    #kw-featproj-{{ section.id }}.kw-featproj--reverse .kw-featproj__media {
      order: 0;
    }
    #kw-featproj-{{ section.id }} .kw-featproj__polaroid {
      width: 46%;
      /* Keep the overhang inside .kw-wrap's 20px min padding so the page
         never picks up a horizontal scrollbar on small screens. */
      bottom: -16px;
      right: -10px;
    }
  }
</style>

{% schema %}
{
  "name": "KW Featured project",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Main image (overrides asset below)" },
    { "type": "text", "id": "image_asset", "label": "Main image — theme asset filename" },
    { "type": "text", "id": "badge", "label": "Image badge text" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "header", "content": "Second photo (small polaroid overlay)" },
    { "type": "image_picker", "id": "image_2", "label": "Second image (overrides asset below)" },
    { "type": "text", "id": "image_2_asset", "label": "Second image — theme asset filename" },
    { "type": "text", "id": "image_2_caption", "label": "Second image caption" },
    { "type": "range", "id": "image_2_rotation", "label": "Second image rotation", "min": -10, "max": 10, "step": 1, "default": -4 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured project" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A home that stands out" },
    { "type": "textarea", "id": "body", "label": "Body copy" },
    { "type": "textarea", "id": "quote", "label": "Homeowner quote (optional)" },
    { "type": "text", "id": "quote_author", "label": "Quote attribution (e.g. name, city)" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [{ "name": "KW Featured project" }]
}
{% endschema %}
