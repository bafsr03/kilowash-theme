{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alt text was wired to the slider labels, so both images shipped as alt="Before" and
  alt="After". That describes the UI control, not the photograph -- it tells a screen
  reader nothing about the roof, and gives Google nothing about the work.

  Dedicated alt fields fix it. The old behaviour stays as the fallback so nothing
  regresses on a section that has not been filled in, but the labels are a last resort
  rather than the default.
{%- endcomment -%}
{%- liquid
  assign ba_after_alt = section.settings.after_image_alt | default: section.settings.after_image.alt | default: section.settings.after_label
  assign ba_before_alt = section.settings.before_image_alt | default: section.settings.before_image.alt | default: section.settings.before_label
-%}

<section class="kw-scope kw-section" id="kw-ba-{{ section.id }}">
  <div class="kw-wrap">
    {% if section.settings.eyebrow != blank %}
      <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="kw-ba__heading kw-reveal">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="kw-ba__sub kw-reveal">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="kw-ba kw-reveal-scale" data-kw-ba>
      <div class="kw-ba__frame">
        <div
          class="kw-ba__img kw-ba__img--after"
          style="--z: {{ section.settings.after_zoom | default: 100 | divided_by: 100.0 }}; --ox: {{ section.settings.after_offset_x | default: 0 }}%; --oy: {{ section.settings.after_offset_y | default: 0 }}%;"
        >
          {% if section.settings.after_image != blank %}
            <img
              src="{{ section.settings.after_image | image_url: width: 1600 }}"
              srcset="{{ section.settings.after_image | image_url: width: 800 }} 800w, {{ section.settings.after_image | image_url: width: 1600 }} 1600w"
              sizes="(max-width: 900px) 100vw, 900px"
              alt="{{ ba_after_alt | escape }}"
              loading="lazy"
              width="{{ section.settings.after_image.width }}"
              height="{{ section.settings.after_image.height }}"
            >
          {% elsif section.settings.after_image_asset != blank %}
            <img src="{{ section.settings.after_image_asset | asset_url }}" alt="{{ ba_after_alt | escape }}" loading="lazy">
          {% endif %}
          <span class="kw-ba__tag kw-ba__tag--after">{{ section.settings.after_label }}</span>
        </div>

        <div
          class="kw-ba__img kw-ba__img--before"
          data-kw-ba-before
          style="--z: {{ section.settings.before_zoom | default: 100 | divided_by: 100.0 }}; --ox: {{ section.settings.before_offset_x | default: 0 }}%; --oy: {{ section.settings.before_offset_y | default: 0 }}%;"
        >
          {% if section.settings.before_image != blank %}
            <img
              src="{{ section.settings.before_image | image_url: width: 1600 }}"
              srcset="{{ section.settings.before_image | image_url: width: 800 }} 800w, {{ section.settings.before_image | image_url: width: 1600 }} 1600w"
              sizes="(max-width: 900px) 100vw, 900px"
              alt="{{ ba_before_alt | escape }}"
              loading="lazy"
              width="{{ section.settings.before_image.width }}"
              height="{{ section.settings.before_image.height }}"
            >
          {% elsif section.settings.before_image_asset != blank %}
            <img src="{{ section.settings.before_image_asset | asset_url }}" alt="{{ ba_before_alt | escape }}" loading="lazy">
          {% endif %}
          <span class="kw-ba__tag kw-ba__tag--before">{{ section.settings.before_label }}</span>
        </div>

        <div class="kw-ba__handle" data-kw-ba-handle>
          <span class="kw-ba__grip">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M6 3 L2 9 L6 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M12 3 L16 9 L12 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </div>

      <input
        type="range"
        class="kw-ba__range"
        data-kw-ba-range
        min="0"
        max="100"
        value="{{ section.settings.start_position }}"
        aria-label="{{ section.settings.before_label }} / {{ section.settings.after_label }} slider"
      >
    </div>
  </div>
</section>

<style>
  #kw-ba-{{ section.id }} {
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-ba-{{ section.id }} .kw-ba__heading {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    max-width: 20ch;
    margin-block: 0.4em 0.6rem;
  }

  #kw-ba-{{ section.id }} .kw-ba__sub {
    color: var(--kw-fg-dim);
    max-width: 60ch;
    margin-block: 0 2.4rem;
  }

  #kw-ba-{{ section.id }} .kw-ba {
    position: relative;
    /* Width drives height via the frame's aspect-ratio, so a portrait shape at
       full width gets very tall — cap it rather than letting it run the page. */
    max-width: {{ section.settings.max_width | default: 900 }}px;
  }

  #kw-ba-{{ section.id }} .kw-ba__frame {
    position: relative;
    aspect-ratio: {{ section.settings.frame_ratio | default: '1 / 1' }};
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--kw-line-bright);
    background: var(--kw-bg-raised);
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
  }

  #kw-ba-{{ section.id }} .kw-ba__img {
    position: absolute;
    inset: 0;
  }

  #kw-ba-{{ section.id }} .kw-ba__img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    /* Per-image framing. Two photos shot from different spots won't line up on
       their own; zoom in to create slack, then nudge each one until the subject
       sits at the same height in both. Offsets are % of the frame, so an offset
       larger than (zoom - 100) / 2 will expose the frame's background. */
    transform: translate(var(--ox, 0), var(--oy, 0)) scale(var(--z, 1));
    transform-origin: center;
  }

  #kw-ba-{{ section.id }} .kw-ba__img--before {
    clip-path: inset(0 calc(100% - var(--kw-ba-pos, 50%)) 0 0);
    will-change: clip-path;
  }

  #kw-ba-{{ section.id }} .kw-ba__tag {
    position: absolute;
    top: 12px;
    font-family: var(--kw-display);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 3px;
    background: rgba(10, 13, 18, 0.72);
    color: var(--kw-fg);
    border: 1px solid var(--kw-line-bright);
  }

  #kw-ba-{{ section.id }} .kw-ba__tag--before { left: 12px; }
  #kw-ba-{{ section.id }} .kw-ba__tag--after {
    right: 12px;
    border-color: var(--kw-gold);
    color: var(--kw-gold);
  }

  #kw-ba-{{ section.id }} .kw-ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--kw-ba-pos, 50%);
    width: 0;
    transform: translateX(-50%);
    pointer-events: none;
  }

  #kw-ba-{{ section.id }} .kw-ba__handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: var(--kw-fg);
    box-shadow: 0 0 0 1px rgba(10, 13, 18, 0.4);
  }

  #kw-ba-{{ section.id }} .kw-ba__grip {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--kw-fg);
    color: var(--kw-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }

  #kw-ba-{{ section.id }} .kw-ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
  }

  #kw-ba-{{ section.id }} .kw-ba__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 40px;
    height: 40px;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('kw-ba-{{ section.id }}');
    if (!root) return;

    var ba = root.querySelector('[data-kw-ba]');
    var frame = root.querySelector('.kw-ba__frame');
    var range = root.querySelector('[data-kw-ba-range]');
    if (!ba || !frame || !range) return;

    function setPos(pct) {
      pct = Math.max(0, Math.min(100, pct));
      ba.style.setProperty('--kw-ba-pos', pct + '%');
      range.value = pct;
    }

    range.addEventListener('input', function () {
      setPos(parseFloat(range.value));
    });

    function pctFromClientX(clientX) {
      var rect = frame.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * 100;
    }

    var dragging = false;

    frame.addEventListener('pointerdown', function (e) {
      dragging = true;
      setPos(pctFromClientX(e.clientX));
    });

    window.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      setPos(pctFromClientX(e.clientX));
    });

    window.addEventListener('pointerup', function () {
      dragging = false;
    });

    setPos(parseFloat(range.value));
  })();
</script>

{% schema %}
{
  "name": "KW Before & After",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "See the difference"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before & after."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "frame_ratio",
      "label": "Frame shape",
      "info": "Portrait shapes show more of a phone photo, so the two shots need less cropping to line up.",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3 / 4",
          "label": "Tall portrait (3:4)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "header",
      "content": "Before image"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image (overrides asset below)"
    },
    {
      "type": "text",
      "id": "before_image_asset",
      "label": "Before image — theme asset filename"
    },
    {
      "type": "text",
      "id": "before_image_alt",
      "label": "Before image alt text",
      "info": "Describe what the photo shows before the work."
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "range",
      "id": "before_zoom",
      "label": "Before — zoom",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "before_offset_x",
      "label": "Before — nudge left/right",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "before_offset_y",
      "label": "Before — nudge up/down",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "After image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image (overrides asset below)"
    },
    {
      "type": "text",
      "id": "after_image_asset",
      "label": "After image — theme asset filename"
    },
    {
      "type": "text",
      "id": "after_image_alt",
      "label": "After image alt text",
      "info": "Describe the finished work, e.g. 'New architectural shingles with the original solar array reinstalled'. Falls back to the slider label."
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "range",
      "id": "after_zoom",
      "label": "After — zoom",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "after_offset_x",
      "label": "After — nudge left/right",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "after_offset_y",
      "label": "After — nudge up/down",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "start_position",
      "label": "Start position",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "KW Before & After",
      "settings": {
        "eyebrow": "See the difference",
        "heading": "Before & after.",
        "before_image_asset": "kw-solar-fan-before.jpg",
        "before_label": "Before",
        "after_image_asset": "kw-solar-fan-after.jpg",
        "after_label": "After"
      }
    }
  ]
}
{% endschema %}
