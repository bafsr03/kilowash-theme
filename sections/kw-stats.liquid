{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

<section class="kw-scope kw-section" id="kw-stats-{{ section.id }}">
  <div class="kw-wrap kw-stats__inner">
    {% for block in section.blocks %}
      <div class="kw-stat kw-reveal" style="transition-delay: {{ forloop.index0 | times: 0.06 }}s" {{ block.shopify_attributes }}>
        {%- comment -%}
          The text node is the REAL number, not 0. kw-theme.js animates from zero on
          scroll, but the count-up only fires at 60% visibility -- so anything that does
          not scroll and run JS (Google, social scrapers, no-JS, reduced-motion users)
          used to read "0+" and "0yr" as the site's actual claims. Rendering the real
          value server-side costs the animation nothing: the script overwrites it on
          entry and still animates to data-count.
        {%- endcomment -%}
        {%- assign stat_display = block.settings.number | round: block.settings.decimals -%}
        <div class="kw-stat__number" data-count="{{ block.settings.number }}" data-suffix="{{ block.settings.suffix }}" data-decimals="{{ block.settings.decimals }}">{{ stat_display }}{{ block.settings.suffix }}</div>
        <div class="kw-stat__label">{{ block.settings.label }}</div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  #kw-stats-{{ section.id }} {
    padding-block: clamp(48px, 7vw, 88px);
    border-block: 1px solid var(--kw-line);
  }

  #kw-stats-{{ section.id }} .kw-stats__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 2rem;
    text-align: left;
  }

  @media (max-width: 700px) {
    #kw-stats-{{ section.id }} .kw-stats__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "KW Stats",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "number", "id": "number", "label": "Number", "default": 10 },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "+" },
        { "type": "number", "id": "decimals", "label": "Decimal places", "default": 0 },
        { "type": "text", "id": "label", "label": "Label", "default": "Installs completed" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KW Stats",
      "blocks": [
        { "type": "stat", "settings": { "number": 50000, "suffix": "+", "label": "LED bulb hours before service" } },
        { "type": "stat", "settings": { "number": 10, "suffix": "yr", "label": "Craftsmanship & lighting warranty" } },
        { "type": "stat", "settings": { "number": 24, "suffix": "hr", "label": "Lead response time" } },
        { "type": "stat", "settings": { "number": 100, "suffix": "%", "label": "Solar-powered attic ventilation" } }
      ]
    }
  ]
}
{% endschema %}
