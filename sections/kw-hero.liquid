{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

<section class="kw-scope kw-hero" id="kw-hero-{{ section.id }}">
  <div class="kw-hero__media">
    {% if section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {% elsif section.settings.image_asset != blank %}
      <img
        src="{{ section.settings.image_asset | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
    <div class="kw-hero__scrim"></div>
    <div class="kw-orbfield">
      <span class="kw-orb kw-orb--gold"></span>
      <span class="kw-orb kw-orb--teal"></span>
    </div>
    <div class="kw-noise"></div>
  </div>

  <div class="kw-wrap kw-hero__inner">
    <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow | default: 'Permanent Lighting &amp; Solar — Utah' }}</p>

    <h1 class="kw-hero__title kw-reveal">{{ section.settings.heading }}</h1>

    <p class="kw-hero__subcopy kw-reveal">{{ section.settings.subheading }}</p>

    <div class="kw-hero__actions kw-reveal">
      {% if section.settings.primary_label != blank %}
        <a href="{{ section.settings.primary_link }}" class="kw-btn kw-magnetic">
          {{ section.settings.primary_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a href="{{ section.settings.secondary_link }}" class="kw-btn kw-btn--ghost kw-magnetic">
          {{ section.settings.secondary_label }}
        </a>
      {% endif %}
    </div>

    <a href="#kw-scroll-cue" class="kw-hero__scrollcue" aria-hidden="true">
      <span></span>
    </a>
  </div>

  {% if section.settings.show_marquee %}
    <div class="kw-marquee">
      <div class="kw-marquee__track">
        {% for i in (1..2) %}
          <span class="kw-marquee__item"><span class="kw-dot"></span>{{ section.settings.marquee_text | default: 'Licensed & Insured' }}</span>
          <span class="kw-marquee__item"><span class="kw-dot"></span>10-Year Warranty</span>
          <span class="kw-marquee__item"><span class="kw-dot"></span>Free On-Site Estimate</span>
          <span class="kw-marquee__item"><span class="kw-dot"></span>Serving the Wasatch Front</span>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  #kw-hero-{{ section.id }} {
    min-height: {{ section.settings.min_height }}svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  #kw-hero-{{ section.id }} .kw-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #kw-hero-{{ section.id }} .kw-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.08) contrast(1.05) brightness(0.82);
  }

  #kw-hero-{{ section.id }} .kw-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #0a0d1299 0%, #0a0d1240 35%, #0a0d12 100%),
      linear-gradient(90deg, #0a0d12cc 0%, transparent 55%);
  }

  #kw-hero-{{ section.id }} .kw-hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(140px, 22vh, 220px) 64px;
  }

  #kw-hero-{{ section.id }} .kw-hero__title {
    font-size: clamp(2.6rem, 7vw, 6rem);
    margin-block: 0.3em 0.35em;
    max-width: 16ch;
    color: var(--kw-fg);
  }

  #kw-hero-{{ section.id }} .kw-hero__subcopy {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: var(--kw-fg-dim);
    max-width: 46ch;
    margin-bottom: 2.4rem;
  }

  #kw-hero-{{ section.id }} .kw-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  #kw-hero-{{ section.id }} .kw-hero__scrollcue {
    display: block;
    width: 26px;
    height: 42px;
    border: 1.5px solid var(--kw-fg-dim);
    border-radius: 100px;
    margin-top: 3.5rem;
    position: relative;
  }

  #kw-hero-{{ section.id }} .kw-hero__scrollcue span {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 4px;
    height: 8px;
    background: var(--kw-gold);
    border-radius: 4px;
    transform: translateX(-50%);
    animation: kw-scrollcue 1.8s ease infinite;
  }

  @keyframes kw-scrollcue {
    0% { transform: translate(-50%, 0); opacity: 1; }
    70% { transform: translate(-50%, 16px); opacity: 0; }
    100% { transform: translate(-50%, 16px); opacity: 0; }
  }

  @media (max-width: 700px) {
    #kw-hero-{{ section.id }} .kw-hero__scrollcue { display: none; }
  }
</style>

{% schema %}
{
  "name": "KW Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background photo (overrides asset below)" },
    { "type": "text", "id": "image_asset", "label": "Background photo — theme asset filename", "info": "Used when no photo is picked above, e.g. kw-light-blue-house.jpg" },
    { "type": "range", "id": "min_height", "label": "Minimum height (svh)", "min": 60, "max": 100, "step": 2, "default": 92 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your home should stand out — day & night." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Permanent architectural lighting and solar solutions, installed and owned by a local Utah crew." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Get a free estimate" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Call / Text 385-406-2335" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link", "default": "tel:3854062335" },
    { "type": "checkbox", "id": "show_marquee", "label": "Show ticker strip", "default": true },
    { "type": "text", "id": "marquee_text", "label": "Ticker highlight" }
  ],
  "presets": [{ "name": "KW Hero" }]
}
{% endschema %}
