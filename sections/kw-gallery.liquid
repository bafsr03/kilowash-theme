{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

<section class="kw-scope kw-section" id="kw-gallery-{{ section.id }}">
  <div class="kw-wrap">
    {% if section.settings.eyebrow != blank %}
      <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="kw-gallery__heading kw-reveal">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="kw-gallery">
      {% for block in section.blocks %}
        <div class="kw-gallery__item kw-reveal-scale{% if block.settings.wide %} kw-gallery__item--wide{% endif %}" style="transition-delay: {{ forloop.index0 | times: 0.06 }}s" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w"
              sizes="(max-width: 900px) 50vw, 33vw"
              alt="{{ block.settings.caption | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% elsif block.settings.image_asset != blank %}
            <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy">
          {% endif %}
          {% if block.settings.caption != blank %}
            <span class="kw-gallery__caption">{{ block.settings.caption }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #kw-gallery-{{ section.id }} {
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-gallery-{{ section.id }} .kw-gallery__heading {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    max-width: 20ch;
    margin-block: 0.4em 2.4rem;
  }
</style>

{% schema %}
{
  "name": "KW Gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Field work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real installs, real Utah homes." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (overrides asset below)" },
        { "type": "text", "id": "image_asset", "label": "Image — theme asset filename" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "checkbox", "id": "wide", "label": "Wide tile (mobile)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "KW Gallery",
      "blocks": [
        { "type": "photo", "settings": { "image_asset": "kw-light-warm-white.jpg", "caption": "Warm white roofline, year-round", "wide": true } },
        { "type": "photo", "settings": { "image_asset": "kw-light-rgb-track.jpg", "caption": "Full-color smart control" } },
        { "type": "photo", "settings": { "image_asset": "kw-light-red-green.jpg", "caption": "Holiday red & green" } },
        { "type": "photo", "settings": { "image_asset": "kw-light-patio-white.jpg", "caption": "Patio & entryway accents" } },
        { "type": "photo", "settings": { "image_asset": "kw-light-blue-house.jpg", "caption": "Two-story installs, done right" } },
        { "type": "photo", "settings": { "image_asset": "kw-light-shop-blue.jpg", "caption": "Commercial & warehouse lighting", "wide": true } },
        { "type": "photo", "settings": { "image_asset": "kw-light-purple-white.jpg", "caption": "Custom color scenes" } },
        { "type": "photo", "settings": { "image_asset": "kw-light-brick-accent.jpg", "caption": "Brick & stone accents" } }
      ]
    }
  ]
}
{% endschema %}
