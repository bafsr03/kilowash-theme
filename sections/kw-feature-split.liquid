{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

<section class="kw-scope kw-section kw-featuresplit{% if section.settings.image_position == 'right' %} kw-featuresplit--reverse{% endif %}" id="kw-fs-{{ section.id }}">
  <div class="kw-wrap kw-featuresplit__inner">
    <div class="kw-featuresplit__media kw-reveal-scale">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 800px) 100vw, 50vw"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {% elsif section.settings.image_asset != blank %}
        <img src="{{ section.settings.image_asset | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {% endif %}
      {% if section.settings.badge != blank %}
        <span class="kw-featuresplit__badge">{{ section.settings.badge }}</span>
      {% endif %}
    </div>
    <div class="kw-featuresplit__content kw-reveal">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h3>{{ section.settings.heading }}</h3>
      <div class="kw-featuresplit__body">{{ section.settings.body }}</div>
      {% if section.settings.list_items != blank %}
        <ul class="kw-featuresplit__list">
          {% assign items = section.settings.list_items | newline_to_br | split: '<br />' %}
          {% for item in items %}
            {% if item != blank %}
              <li>{{ item | strip }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link_url }}" class="kw-btn kw-btn--teal kw-magnetic">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #kw-fs-{{ section.id }} {
    padding-block: clamp(40px, 6vw, 84px);
  }

  #kw-fs-{{ section.id }} .kw-featuresplit__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  #kw-fs-{{ section.id }}.kw-featuresplit--reverse .kw-featuresplit__media {
    order: 2;
  }

  #kw-fs-{{ section.id }} .kw-featuresplit__media {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  #kw-fs-{{ section.id }} .kw-featuresplit__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #kw-fs-{{ section.id }} .kw-featuresplit__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--kw-gold);
    color: var(--kw-bg);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.5em 0.9em;
    border-radius: 100px;
  }

  #kw-fs-{{ section.id }} h3 {
    font-family: var(--kw-display);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    margin-block: 0.4em 0.6em;
  }

  #kw-fs-{{ section.id }} .kw-featuresplit__body {
    color: var(--kw-fg-dim);
    max-width: 44ch;
    margin-bottom: 1.2rem;
    line-height: 1.6;
  }

  #kw-fs-{{ section.id }} .kw-featuresplit__list {
    list-style: none;
    margin: 0 0 1.8rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  #kw-fs-{{ section.id }} .kw-featuresplit__list li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--kw-fg);
    font-size: 0.95rem;
  }

  #kw-fs-{{ section.id }} .kw-featuresplit__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--kw-teal);
    box-shadow: 0 0 10px 1px var(--kw-teal);
  }

  @media (max-width: 800px) {
    #kw-fs-{{ section.id }} .kw-featuresplit__inner {
      grid-template-columns: 1fr;
    }
    #kw-fs-{{ section.id }}.kw-featuresplit--reverse .kw-featuresplit__media {
      order: 0;
    }
  }
</style>

{% schema %}
{
  "name": "KW Feature split",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (overrides asset below)" },
    { "type": "text", "id": "image_asset", "label": "Image — theme asset filename" },
    { "type": "text", "id": "badge", "label": "Image badge text" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feature heading" },
    { "type": "textarea", "id": "body", "label": "Body copy" },
    { "type": "textarea", "id": "list_items", "label": "Bullet list (one per line)" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [{ "name": "KW Feature split" }]
}
{% endschema %}
