{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

<section class="kw-scope kw-cta" id="kw-cta-{{ section.id }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap">
    <div class="kw-cta__inner kw-bracket">
      <div class="kw-scanline"></div>
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="kw-cta__heading kw-reveal">{{ section.settings.heading }}</h2>
      <p class="kw-cta__phone kw-reveal">
        <a href="tel:{{ section.settings.phone_link }}">{{ section.settings.phone_display }}</a>
        <a href="sms:{{ section.settings.phone_link }}" class="kw-cta__text-link">or text us</a>
      </p>
      <div class="kw-cta__actions kw-reveal">
        {% if section.settings.primary_label != blank %}
          <a href="{{ section.settings.primary_link }}" class="kw-btn">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a href="{{ section.settings.secondary_link }}" class="kw-btn kw-btn--ghost">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #kw-cta-{{ section.id }} {
    position: relative;
    overflow: clip;
    padding-block: clamp(64px, 10vw, 128px);
    text-align: center;
    background: var(--kw-bg);
  }

  #kw-cta-{{ section.id }} .kw-cta__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(28px, 5vw, 56px) clamp(20px, 4vw, 48px);
  }

  #kw-cta-{{ section.id }} .kw-eyebrow {
    justify-content: center;
  }

  #kw-cta-{{ section.id }} .kw-cta__heading {
    font-size: clamp(2.2rem, 5.6vw, 4.2rem);
    max-width: 18ch;
    margin-block: 0.4em 0.5em;
  }

  #kw-cta-{{ section.id }} .kw-cta__phone {
    margin: 0 0 2rem;
  }

  #kw-cta-{{ section.id }} .kw-cta__phone a {
    font-family: var(--kw-display);
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    color: var(--kw-gold);
    text-decoration: none;
    border-bottom: 1px solid var(--kw-line-bright);
    padding-bottom: 0.15em;
    transition: border-color 0.3s ease;
  }

  #kw-cta-{{ section.id }} .kw-cta__phone a:hover {
    border-color: var(--kw-gold);
  }

  #kw-cta-{{ section.id }} .kw-cta__text-link {
    font-family: var(--kw-body);
    font-size: 0.85rem;
    color: var(--kw-teal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    border-bottom: none;
    padding-bottom: 0;
    margin-left: 0.8em;
  }

  #kw-cta-{{ section.id }} .kw-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>

{% schema %}
{
  "name": "KW CTA banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready when you are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "If your home is dark, you're missing out on the wow factor." },
    { "type": "text", "id": "phone_display", "label": "Phone (display)", "default": "385-406-2335" },
    { "type": "text", "id": "phone_link", "label": "Phone (tel link)", "default": "3854062335" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Get my free estimate" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Email us" },
    { "type": "text", "id": "secondary_link", "label": "Secondary button link", "default": "mailto:KilowashUtah@gmail.com" }
  ],
  "presets": [{ "name": "KW CTA banner" }]
}
{% endschema %}
