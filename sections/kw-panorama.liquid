{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Panorama strip: very wide photos (phone panoramas, about 3:1) in a full-bleed row
  that scrolls sideways. A wide photo squeezed into the page grid shrinks to a
  sliver; here each one keeps a usable height and the next one peeks in from the
  right so it reads as scrollable. Swipe on touch, arrow buttons or trackpad on
  desktop.

  Every frame is the same 3:1 box with object-fit: cover, so mixed panoramas line up
  and theme assets (which have no dimensions in Liquid) cannot shift the row while
  they load.
{%- endcomment -%}

<section class="kw-scope kw-section{% if section.settings.raised %} kw-section--raised{% endif %} kw-pano" id="kw-pano-{{ section.id }}">
  <div class="kw-wrap kw-pano__head">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="kw-pano__title kw-reveal">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
    {% if section.blocks.size > 1 %}
      <div class="kw-pano__nav">
        <button type="button" class="kw-pano__btn" data-kw-pano-dir="-1" aria-label="Previous photo" disabled>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="kw-pano__btn" data-kw-pano-dir="1" aria-label="Next photo">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    {% endif %}
  </div>

  <div class="kw-pano__track" tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Panorama photos' | escape }}">
    {% for block in section.blocks %}
      {%- assign pano_alt = block.settings.image_alt | default: block.settings.caption -%}
      <figure class="kw-pano__item" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 2400 }}"
            srcset="{{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
            sizes="(max-width: 800px) 180vw, 85vw"
            alt="{{ pano_alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% elsif block.settings.image_asset != blank %}
          <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ pano_alt | escape }}" loading="lazy" width="2400" height="800">
        {% endif %}
        {% if block.settings.caption != blank %}
          <figcaption class="kw-pano__caption">{{ block.settings.caption }}</figcaption>
        {% endif %}
      </figure>
    {% endfor %}
  </div>
</section>

<style>
  #kw-pano-{{ section.id }} {
    --pano-gutter: max(clamp(20px, 5vw, 64px), calc((100% - 1320px) / 2 + 64px));
    --pano-h: clamp(220px, 30vw, 420px);
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-pano-{{ section.id }} .kw-pano__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  #kw-pano-{{ section.id }} .kw-pano__title {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    max-width: 20ch;
    margin-top: 0.4em;
  }

  #kw-pano-{{ section.id }} .kw-pano__nav {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  #kw-pano-{{ section.id }} .kw-pano__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--kw-line-bright);
    border-radius: 3px;
    background: transparent;
    color: var(--kw-fg);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  #kw-pano-{{ section.id }} .kw-pano__btn:hover:not(:disabled),
  #kw-pano-{{ section.id }} .kw-pano__btn:focus-visible {
    border-color: var(--kw-gold);
    color: var(--kw-gold);
  }

  #kw-pano-{{ section.id }} .kw-pano__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  #kw-pano-{{ section.id }} .kw-pano__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--pano-gutter);
    scroll-padding-inline: var(--pano-gutter);
    padding-bottom: 14px;
    scrollbar-width: thin;
    scrollbar-color: var(--kw-line-bright) transparent;
  }

  #kw-pano-{{ section.id }} .kw-pano__track:focus-visible {
    outline: 1px solid var(--kw-gold);
    outline-offset: 4px;
  }

  #kw-pano-{{ section.id }} .kw-pano__item {
    position: relative;
    flex: 0 0 auto;
    width: calc(var(--pano-h) * 3);
    max-width: calc(100vw - 48px);
    height: var(--pano-h);
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--kw-line);
    scroll-snap-align: start;
  }

  #kw-pano-{{ section.id }} .kw-pano__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #kw-pano-{{ section.id }} .kw-pano__caption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    max-width: calc(100% - 24px);
    font-family: var(--kw-display);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--kw-fg);
    background: #0a0d12cc;
    border: 1px solid var(--kw-line-bright);
    padding: 0.5em 0.8em;
    border-radius: 3px;
  }

  /* Phones: the 3:1 box would be a thin strip at screen width, so give it more
     height and let it run wider than the screen. Swiping pans across it. */
  @media (max-width: 800px) {
    #kw-pano-{{ section.id }} {
      --pano-h: 240px;
    }

    #kw-pano-{{ section.id }} .kw-pano__item {
      width: 86vw;
      max-width: none;
    }

    #kw-pano-{{ section.id }} .kw-pano__nav {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('kw-pano-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.kw-pano__track');
    var buttons = root.querySelectorAll('[data-kw-pano-dir]');
    if (!track || !buttons.length) return;
    var smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function paint() {
      var max = track.scrollWidth - track.clientWidth - 2;
      buttons[0].disabled = track.scrollLeft <= 2;
      buttons[1].disabled = track.scrollLeft >= max;
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = track.querySelector('.kw-pano__item');
        var step = item ? item.getBoundingClientRect().width + 12 : track.clientWidth * 0.8;
        track.scrollBy({ left: step * Number(btn.getAttribute('data-kw-pano-dir')), behavior: smooth ? 'smooth' : 'auto' });
      });
    });

    track.addEventListener('scroll', paint, { passive: true });
    window.addEventListener('resize', paint);
    paint();
  })();
</script>

{% schema %}
{
  "name": "KW Panorama strip",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The whole building, end to end." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Panorama",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (overrides asset below)" },
        { "type": "text", "id": "image_asset", "label": "Photo — theme asset filename" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "image_alt", "label": "Alt text", "info": "Describe the photo for screen readers and search. Falls back to the caption." }
      ]
    }
  ],
  "presets": [{ "name": "KW Panorama strip" }]
}
{% endschema %}
