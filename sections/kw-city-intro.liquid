{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  KW City intro: the part of a city page that is actually about the city.

  Renders the page's own content from the Shopify admin (Online Store > Pages), so
  every city page carries copy written for that place: the neighbourhoods we have
  worked in, HOA notes, typical rooflines, and a real install photo from that city,
  inserted into the page body. Everything else on the city template is shared.

  A city page whose body is empty would be the same page as every other city with
  the name swapped, which Google treats as a doorway page. kw-seo-meta therefore
  noindexes any city page with an empty body, and this section renders nothing.
{%- endcomment -%}

{%- if page.content != blank -%}
  <section class="kw-scope kw-section" id="kw-city-{{ section.id }}">
    <div class="kw-blueprint"></div>
    <div class="kw-wrap kw-city__inner">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow | replace: '[city]', page.title }}</p>
      {% endif %}
      <h2 class="kw-city__heading kw-reveal">{{ section.settings.heading | replace: '[city]', page.title }}</h2>
      <div class="kw-city__body kw-reveal">{{ page.content }}</div>
    </div>
  </section>

  <style>
    #kw-city-{{ section.id }} {
      padding-block: clamp(48px, 6.5vw, 92px);
    }

    #kw-city-{{ section.id }} .kw-city__heading {
      font-family: var(--kw-display);
      font-size: clamp(1.7rem, 3.2vw, 2.6rem);
      max-width: 24ch;
      margin-block: 0.4em 1.2rem;
    }

    #kw-city-{{ section.id }} .kw-city__body {
      color: var(--kw-fg-dim);
      max-width: 66ch;
      font-size: 1rem;
      line-height: 1.68;
    }

    #kw-city-{{ section.id }} .kw-city__body img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      margin-block: 1.2rem;
    }

    #kw-city-{{ section.id }} .kw-city__body a {
      color: var(--kw-fg);
      border-bottom: 1px solid var(--kw-gold);
      text-decoration: none;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "KW City intro",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "[city] is replaced with the page title.",
      "default": "Local to [city]"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "[city] is replaced with the page title. The body comes from the page's own content in Online Store > Pages.",
      "default": "Permanent lighting in [city]"
    }
  ],
  "presets": [{ "name": "KW City intro" }]
}
{% endschema %}
