{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The review count links to the Google Business Profile so the rating is checkable
  rather than a number we assert about ourselves. The section-level URL wins; the
  sitewide Theme settings > Kilowash SEO value is the fallback, so filling that in
  once links every instance of this section at the same time.
{%- endcomment -%}
{%- assign gr_profile_url = section.settings.profile_url | default: settings.kw_seo_gbp_url -%}

<section class="kw-scope kw-section" id="kw-google-reviews-{{ section.id }}">
  <div class="kw-wrap">
    {% if section.settings.eyebrow != blank %}
      <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="kw-google-reviews__heading kw-reveal">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.rating != blank %}
      <div class="kw-google-reviews__summary kw-reveal-scale">
        <span class="kw-google-reviews__score">{{ section.settings.rating }}</span>
        <span class="kw-google-reviews__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        {% if section.settings.count != blank %}
          <span class="kw-google-reviews__count">
            {%- if gr_profile_url != blank -%}
              <a href="{{ gr_profile_url }}" target="_blank" rel="noopener">{{ section.settings.count }}</a>
            {%- else -%}
              {{ section.settings.count }}
            {%- endif -%}
          </span>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.embed_code != blank %}
      <div class="kw-google-reviews__embed kw-reveal-scale">
        {{ section.settings.embed_code }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #kw-google-reviews-{{ section.id }} {
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-google-reviews-{{ section.id }} .kw-google-reviews__heading {
    font-family: var(--kw-display);
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    max-width: 24ch;
    margin-block: 0.4em 2.4rem;
  }

  #kw-google-reviews-{{ section.id }} .kw-google-reviews__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    background: var(--kw-bg-raised);
    border: 1px solid var(--kw-line);
    border-radius: 100px;
    padding: 0.9rem 1.6rem;
  }

  #kw-google-reviews-{{ section.id }} .kw-google-reviews__score {
    font-family: var(--kw-display);
    font-size: 1.8rem;
    line-height: 1;
    color: var(--kw-fg);
  }

  #kw-google-reviews-{{ section.id }} .kw-google-reviews__stars {
    color: var(--kw-gold);
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }

  #kw-google-reviews-{{ section.id }} .kw-google-reviews__count {
    font-size: 0.85rem;
    color: var(--kw-fg-dim);
  }

  #kw-google-reviews-{{ section.id }} .kw-google-reviews__count a {
    color: var(--kw-fg-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #kw-google-reviews-{{ section.id }} .kw-google-reviews__count a:hover {
    color: var(--kw-gold);
  }

  #kw-google-reviews-{{ section.id }} .kw-google-reviews__embed {
    margin-top: 1.8rem;
  }
</style>

{% schema %}
{
  "name": "KW Google Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verified on Google" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "5-star rated, straight from Google." },
    { "type": "text", "id": "rating", "label": "Average rating (e.g. 5.0)", "info": "Leave blank to hide the rating bar. Update this by hand when the Google score changes." },
    { "type": "text", "id": "count", "label": "Review count text (e.g. 28 Google reviews)" },
    { "type": "url", "id": "profile_url", "label": "Link to your Google reviews" },
    {
      "type": "liquid",
      "id": "embed_code",
      "label": "Google reviews widget embed code",
      "info": "Paste the embed script/HTML from your review widget provider (e.g. Elfsight, SociableKIT). It renders live and auto-updates as new Google reviews come in — no theme edits needed after this."
    }
  ],
  "presets": [
    { "name": "KW Google Reviews" }
  ]
}
{% endschema %}
