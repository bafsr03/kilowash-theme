{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

<section class="kw-scope kw-section kw-section--raised kw-qform" id="{{ section.settings.anchor_id | default: 'quote-form' }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap kw-qform__inner">
    <div class="kw-qform__intro kw-reveal">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <p class="kw-qform__lede">{{ section.settings.subheading }}</p>

      {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
        <a href="{{ section.settings.secondary_link }}" target="_blank" rel="noopener" class="kw-qform__altlink">
          {{ section.settings.secondary_label }}
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
      {% endif %}
    </div>

    <div class="kw-qform__panel kw-reveal-scale kw-bracket">
      <div class="kw-scanline"></div>

      {% assign form_id = 'QuoteForm-' | append: section.id %}
      {%- form 'contact', id: form_id, class: 'kw-qform__form', data-kw-spamguard: '' -%}
        <input type="hidden" name="contact[id]" value="{{ form_id }}">
        <input type="hidden" name="contact[Lead source]" value="Website quote form">
        {%- comment -%}
          Filled from the estimator (kw-estimator stores the visitor's configuration in
          sessionStorage), so a lead that priced a roofline arrives saying what it
          priced instead of starting the conversation from zero.
        {%- endcomment -%}
        <input type="hidden" name="contact[Estimator result]" value="" data-kw-estimate-field>

        <div class="kw-qform__trap" aria-hidden="true">
          <label for="{{ form_id }}-website">Website</label>
          <input type="text" id="{{ form_id }}-website" name="contact[website]" tabindex="-1" autocomplete="off">
        </div>
        <input type="hidden" name="contact[form_rendered_at]" class="kw-qform__rendered-at" value="">

        {% liquid
          assign form_matches = false
          if form.id == form_id or form.id == blank
            assign form_matches = true
          endif
        %}

        {%- if form.errors and form_matches -%}
          <div class="kw-qform__error" tabindex="-1" autofocus>
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form_matches -%}
          <div class="kw-qform__success" tabindex="-1" autofocus>
            Thanks — your request is in. We'll call or text within 24 hours to confirm next steps.
          </div>
          <script>
            window.kwTrack && window.kwTrack('generate_lead', { form: 'quote' });
            try { sessionStorage.removeItem('kwEstimate'); } catch (e) {}
          </script>
        {%- else -%}
          <div class="kw-qform__row">
            <label class="kw-qform__field">
              <span class="kw-qform__label">Full name</span>
              <input type="text" class="kw-qform__input" autocomplete="name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
            </label>
            <label class="kw-qform__field">
              <span class="kw-qform__label">Phone</span>
              <input type="tel" class="kw-qform__input" autocomplete="tel" name="contact[phone]" pattern="[0-9\-\+\(\)\s]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" required>
            </label>
          </div>

          <p class="kw-qform__estimate" data-kw-estimate-note hidden></p>

          <label class="kw-qform__field">
            <span class="kw-qform__label">Email</span>
            <input type="email" class="kw-qform__input" autocomplete="email" spellcheck="false" autocapitalize="off" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
          </label>

          <label class="kw-qform__field">
            <span class="kw-qform__label">Service address</span>
            <input type="text" class="kw-qform__input" autocomplete="street-address" name="contact[Service address]" placeholder="Street, city, state, ZIP" required>
          </label>

          <div class="kw-qform__row">
            <label class="kw-qform__field">
              <span class="kw-qform__label">What do you need?</span>
              <select class="kw-qform__input kw-qform__select" name="contact[Service type]" required>
                <option value="" disabled selected>Choose a service</option>
                <option value="Permanent Lights">Permanent Christmas / architectural lights</option>
                <option value="Attic Fan">Solar attic fan</option>
                <option value="Solar panel cleaning">Solar panel cleaning</option>
                <option value="Solar removal & reinstall">Solar panel removal &amp; reinstall</option>
                <option value="Critter Guard">Critter Guard / pigeon proofing</option>
                <option value="Solar Solutions">Other solar service</option>
                <option value="Not sure / other">Not sure / other</option>
              </select>
            </label>
            <label class="kw-qform__field">
              <span class="kw-qform__label">Timeline</span>
              <select class="kw-qform__input kw-qform__select" name="contact[Preferred timeline]">
                <option value="As soon as possible">As soon as possible</option>
                <option value="Within 2 weeks">Within 2 weeks</option>
                <option value="Within a month">Within a month</option>
                <option value="Just researching">Just researching</option>
              </select>
            </label>
          </div>

          {%- comment -%}
            Lead attribution. The hidden contact[Lead source] field above records that a
            lead came through this form; it cannot say what sent the customer here. That
            is the one thing no analytics tool can answer for phone-and-referral trades,
            and without it there is no way to tell whether the SEO work, the Google
            Business Profile or word of mouth is producing the calls.

            Left optional on purpose -- it is our question, not the customer's problem,
            and a required field here would cost more leads than the data is worth.
          {%- endcomment -%}
          <label class="kw-qform__field">
            <span class="kw-qform__label">How did you hear about us? <span class="kw-qform__optional">(optional)</span></span>
            <select class="kw-qform__input kw-qform__select" name="contact[How did you hear about us]">
              <option value="">Select one</option>
              <option value="Google search">Google search</option>
              <option value="Google Maps">Google Maps</option>
              <option value="Friend or neighbour referral">Friend or neighbour referral</option>
              <option value="Saw a Kilowash install">Saw a Kilowash install</option>
              <option value="Facebook or Instagram">Facebook or Instagram</option>
              <option value="Nextdoor">Nextdoor</option>
              <option value="Yelp, Angi or BBB">Yelp, Angi or BBB</option>
              <option value="Other">Other</option>
            </select>
          </label>

          <label class="kw-qform__field">
            <span class="kw-qform__label">Project details</span>
            <textarea rows="4" class="kw-qform__input kw-qform__textarea" name="contact[body]" placeholder="Tell us about your home, roofline, or what you're hoping to get done.">{{ form.body }}</textarea>
          </label>

          <button type="submit" class="kw-btn kw-qform__submit">
            {{ section.settings.submit_label | default: 'Request a quote' }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  #{{ section.settings.anchor_id | default: 'quote-form' }}.kw-qform {
    padding-block: clamp(56px, 8vw, 108px);
    scroll-margin-top: 96px;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__intro h2 {
    font-family: var(--kw-display);
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    margin-block: 0.4em 0.6em;
    max-width: 16ch;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__lede {
    color: var(--kw-fg-dim);
    max-width: 38ch;
    line-height: 1.6;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__altlink {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--kw-teal);
    text-decoration: none;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 0.2em;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__altlink:hover {
    color: var(--kw-gold);
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__panel {
    background: var(--kw-bg);
    border: 1px solid var(--kw-line);
    border-radius: 24px;
    padding: clamp(20px, 3vw, 32px);
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__field {
    display: block;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__label {
    display: block;
    font-size: 0.82rem;
    color: var(--kw-fg-dim);
    margin-bottom: 0.5rem;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__estimate {
    margin: 0 0 1rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--kw-gold);
    border-radius: 6px;
    font-size: 0.92rem;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__optional {
    opacity: 0.85;
    font-size: 0.94em;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__input {
    width: 100%;
    color: var(--kw-fg);
    background: var(--kw-bg-raised);
    border: 1px solid var(--kw-line);
    border-radius: 10px;
    padding: 0.85em 1em;
    font-family: var(--kw-body);
    font-size: 0.95rem;
    transition: border-color 0.25s ease;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__input:focus-visible {
    outline: none;
    border-color: var(--kw-gold);
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__select {
    appearance: auto;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__textarea {
    resize: vertical;
    min-height: 8rem;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__submit {
    align-self: flex-start;
    margin-top: 0.4rem;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__error,
  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__success {
    padding: 1em 1.2em;
    border-radius: 10px;
    font-size: 0.9rem;
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__error {
    background: #f5b94222;
    border: 1px solid var(--kw-gold);
    color: var(--kw-fg);
  }

  #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__success {
    background: #29d9c222;
    border: 1px solid var(--kw-teal);
    color: var(--kw-fg);
  }

  @media (max-width: 800px) {
    #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__inner {
      grid-template-columns: 1fr;
    }
    #{{ section.settings.anchor_id | default: 'quote-form' }} .kw-qform__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById({{ section.settings.anchor_id | default: 'quote-form' | json }});
    if (!root) return;
    var saved;
    try { saved = JSON.parse(sessionStorage.getItem('kwEstimate') || 'null'); } catch (e) { saved = null; }
    if (!saved || !saved.summary) return;
    var field = root.querySelector('[data-kw-estimate-field]');
    var note = root.querySelector('[data-kw-estimate-note]');
    if (field) field.value = saved.summary;
    if (note) {
      note.textContent = 'Your estimate: ' + saved.summary + '. We will confirm it on a free on-site visit.';
      note.hidden = false;
    }
    var select = root.querySelector('select[name="contact[Service type]"]');
    if (select && !select.value && saved.service) select.value = saved.service;
  })();
</script>

{% schema %}
{
  "name": "KW Quote form",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID (for linking, e.g. #quote-form)", "default": "quote-form" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Request a quote" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us about your home." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Send the details and we'll follow up within 24 hours to schedule your free on-site estimate." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Request a quote" },
    { "type": "header", "content": "Alternate booking link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Prefer to book directly? Open our scheduling portal" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link URL", "info": "e.g. your Jobber Client Hub request link" }
  ],
  "presets": [{ "name": "KW Quote form" }]
}
{% endschema %}
