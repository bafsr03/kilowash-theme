{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  KW Service area — "where we work" + related pages.

  Closes two gaps at once:

  1. Local relevance. Before this, the deepest geography anywhere in the site copy
     was a single state name. Google matches a service-area business to a city
     query partly on whether that city appears in crawlable copy that agrees with
     the Google Business Profile service area. This block names the cities once, in
     a place a real customer would look for them.

  2. Internal linking. Every link on the site pointed at /pages/estimate; the
     lighting, solar and testimonials pages never linked to each other, so link
     equity dead-ended. The related-links row connects them.

  This is deliberately a genuine, useful page element and not a keyword list — a
  homeowner scanning for "do they come to Lehi" is the actual audience. Do not
  expand the place list past where the crew will really drive.

  Places are rendered GROUPED BY STATE, drawn from the positional lists in
  Theme settings > Kilowash SEO (list N belongs to state N in "States served").
  Grouping is not decoration: Kilowash now works either side of the Ohio/West
  Virginia line, and "Wood County" is a real county in both Ohio and West
  Virginia. An ungrouped pill reading "Wood County" would point a Parkersburg
  homeowner at a county four hours away. The state label is what disambiguates
  it, and it mirrors the containedInPlace nesting in kw-schema-areaserved so the
  visible copy and the structured data say the same thing.

  A single state with places, and no others, renders with no group label — the
  heading already says where we are, and a lone "Utah" label is noise.

  "Markets to show" narrows the section to market 1 alone. The homepage uses it:
  a Google Business Profile ranks strongest near its registered address, so a
  homepage that gives three states equal billing tells Google the business is not
  specifically local anywhere. The other markets are not hidden, they keep their
  own page and stay whole in the structured data -- only the emphasis moves.

  The section-level "Places" box still overrides everything with a flat,
  ungrouped list, for a page that needs a one-off territory.
{%- endcomment -%}

{%- liquid
  assign override = section.settings.cities | strip
  assign state_list = settings.kw_seo_states_served | split: ','
  assign markets_mode = section.settings.markets | default: 'all'

  assign labelled_groups = 0
  for state in state_list
    assign state_name = state | strip
    if state_name == blank
      continue
    endif
    if markets_mode == 'first' and forloop.index > 1
      continue
    endif
    case forloop.index
      when 1
        assign probe = settings.kw_seo_areas_served | strip
      when 2
        assign probe = settings.kw_seo_areas_served_2 | strip
      when 3
        assign probe = settings.kw_seo_areas_served_3 | strip
      else
        assign probe = ''
    endcase
    if probe != blank
      assign labelled_groups = labelled_groups | plus: 1
    endif
  endfor
-%}

<section class="kw-scope kw-section{% if section.settings.raised %} kw-section--raised{% endif %}" id="kw-area-{{ section.id }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap kw-area__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="kw-area__heading kw-reveal">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="kw-area__body kw-reveal">{{ section.settings.body }}</div>
    {% endif %}

    {% if override != blank %}
      {% assign places = override | split: ',' %}
      <ul class="kw-area__cities kw-reveal">
        {% for place in places %}
          {% assign place_name = place | strip %}
          {% if place_name != blank %}
            <li>{{ place_name }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% else %}
      {% for state in state_list %}
        {% assign state_name = state | strip %}
        {% assign skip_market = false %}
        {% if markets_mode == 'first' and forloop.index > 1 %}
          {% assign skip_market = true %}
        {% endif %}
        {% if state_name != blank and skip_market == false %}
          {% case forloop.index %}
            {% when 1 %}
              {% assign places_raw = settings.kw_seo_areas_served %}
            {% when 2 %}
              {% assign places_raw = settings.kw_seo_areas_served_2 %}
            {% when 3 %}
              {% assign places_raw = settings.kw_seo_areas_served_3 %}
            {% else %}
              {% assign places_raw = '' %}
          {% endcase %}
          {% assign places_trimmed = places_raw | strip %}
          {% if places_trimmed != blank %}
            {% assign places = places_raw | split: ',' %}
            {% assign group_id = 'kw-area-' | append: section.id | append: '-' | append: forloop.index %}
            <div class="kw-area__group kw-reveal">
              {% if labelled_groups > 1 %}
                <p class="kw-area__group-label" id="{{ group_id }}">{{ state_name }}</p>
              {% endif %}
              <ul class="kw-area__cities"{% if labelled_groups > 1 %} aria-labelledby="{{ group_id }}"{% endif %}>
                {% for place in places %}
                  {% assign place_name = place | strip %}
                  {% if place_name != blank %}
                    <li>{{ place_name }}</li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if section.blocks.size > 0 %}
      <nav class="kw-area__links kw-reveal" aria-label="{{ section.settings.links_label | escape }}">
        <p class="kw-area__links-label">{{ section.settings.links_label }}</p>
        <ul>
          {% for block in section.blocks %}
            {% if block.settings.label != blank and block.settings.url != blank %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </div>
</section>

<style>
  #kw-area-{{ section.id }} {
    padding-block: clamp(48px, 6.5vw, 92px);
  }

  #kw-area-{{ section.id }} .kw-area__heading {
    font-size: clamp(1.7rem, 3.2vw, 2.6rem);
    max-width: 22ch;
    margin-block: 0.4em 0.8rem;
  }

  #kw-area-{{ section.id }} .kw-area__body {
    color: var(--kw-fg-dim);
    max-width: 62ch;
    font-size: 0.96rem;
    line-height: 1.62;
  }

  #kw-area-{{ section.id }} .kw-area__group {
    margin-top: 1.8rem;
  }

  #kw-area-{{ section.id }} .kw-area__group-label {
    font-family: var(--kw-display);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kw-fg-dim);
    margin: 0 0 0.7rem;
  }

  #kw-area-{{ section.id }} .kw-area__cities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.8rem 0 0;
  }

  #kw-area-{{ section.id }} .kw-area__group .kw-area__cities {
    margin-top: 0;
  }

  #kw-area-{{ section.id }} .kw-area__cities li {
    border: 1px solid var(--kw-line);
    border-radius: 999px;
    padding: 0.38rem 0.85rem;
    font-size: 0.84rem;
    color: var(--kw-fg-dim);
    letter-spacing: 0.01em;
  }

  #kw-area-{{ section.id }} .kw-area__links {
    margin-top: 2.2rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--kw-line);
  }

  #kw-area-{{ section.id }} .kw-area__links-label {
    font-family: var(--kw-display);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kw-fg-dim);
    margin: 0 0 0.9rem;
  }

  #kw-area-{{ section.id }} .kw-area__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #kw-area-{{ section.id }} .kw-area__links a {
    color: var(--kw-fg);
    text-decoration: none;
    border-bottom: 1px solid var(--kw-gold);
    padding-bottom: 2px;
    font-size: 0.94rem;
    transition: color 0.25s ease;
  }

  #kw-area-{{ section.id }} .kw-area__links a:hover {
    color: var(--kw-gold);
  }
</style>

{% schema %}
{
  "name": "KW Service area",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where we work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where we work" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>We run our own crews in every market we serve. If your town is not on this list, call or text us anyway — we will tell you straight whether we can get to you.</p>" },
    { "type": "select", "id": "markets", "label": "Markets to show", "default": "all", "options": [ { "value": "all", "label": "All markets" }, { "value": "first", "label": "Home market only (market 1)" } ], "info": "The homepage uses 'Home market only' so its local signal points at one place. Other pages show every market." },
    { "type": "textarea", "id": "cities", "label": "Places (override)", "info": "Comma separated. Leave blank to show the full service area from Theme settings > Kilowash SEO, grouped by state. Fill this in only to override this one section with a flat, ungrouped list. Only list places the crew will actually drive." },
    { "type": "text", "id": "links_label", "label": "Related links label", "default": "More from Kilowash" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Related link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Permanent lighting" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KW Service area",
      "blocks": [
        { "type": "link", "settings": { "label": "Permanent architectural lighting", "url": "/pages/lighting" } },
        { "type": "link", "settings": { "label": "Solar attic fans & panel care", "url": "/pages/solar" } },
        { "type": "link", "settings": { "label": "Reviews & finished projects", "url": "/pages/testimonials" } },
        { "type": "link", "settings": { "label": "Get a free estimate", "url": "/pages/estimate" } }
      ]
    }
  ]
}
{% endschema %}
