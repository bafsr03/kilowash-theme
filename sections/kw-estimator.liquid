{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The opening state is rendered server-side rather than left to JS.

  The panel used to ship `$0` in the markup and rely on compute() to replace it at
  parse time. A visitor barely sees it, but view-source does -- and so do Google, the
  social scrapers that build link previews, and anyone whose JS fails. The first price
  associated with Kilowash should never be zero.

  All three opening values (slider position, the "120 ft" readout, and the total)
  derive from est_default_ft and the section's own rate settings here, so they cannot
  drift apart from each other or from the JS, which recomputes from the same settings.
  The default reflects a typical Utah home: 120 ft with the Smart App Control box on,
  which is checked by default below. The power box is not included because it only
  becomes required past the threshold setting (200 ft).
{%- endcomment -%}
{%- liquid
  assign est_default_ft = 120
  assign est_rate_ft = section.settings.rate_ft | default: 27
  assign est_rate_smart = section.settings.rate_smart_addon | default: 500
  assign est_default_total = est_default_ft | times: est_rate_ft | plus: est_rate_smart

  assign est_str = est_default_total | round: 0 | append: ''
  assign est_len = est_str | size
  if est_len > 3
    assign est_cut = est_len | minus: 3
    assign est_head = est_str | slice: 0, est_cut
    assign est_tail = est_str | slice: est_cut, 3
    assign est_display = est_head | append: ',' | append: est_tail
  else
    assign est_display = est_str
  endif
-%}

<section class="kw-scope kw-section kw-section--raised" id="kw-est-{{ section.id }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap kw-est__inner">
    <div class="kw-est__intro kw-reveal">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <p class="kw-est__lede">{{ section.settings.subheading }}</p>
    </div>

    <div class="kw-est__panel kw-reveal-scale">
      <div class="kw-est__tabs" role="tablist" aria-label="Estimate type">
        <button type="button" role="tab" aria-selected="true" aria-controls="kw-est-{{ section.id }}-lighting" id="kw-est-{{ section.id }}-tab-lighting" class="kw-est__tab is-active" data-kw-tab="lighting">Permanent Lighting</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="kw-est-{{ section.id }}-solar" id="kw-est-{{ section.id }}-tab-solar" class="kw-est__tab" data-kw-tab="solar">Solar &amp; Attic</button>
      </div>

      <div class="kw-est__pane is-active" data-kw-pane="lighting" role="tabpanel" id="kw-est-{{ section.id }}-lighting" aria-labelledby="kw-est-{{ section.id }}-tab-lighting">
        <label class="kw-est__field">
          <span class="kw-est__field-label">Linear feet of roofline / trim</span>
          <input type="range" min="20" max="650" step="10" value="{{ est_default_ft }}" data-kw-ft>
          <span class="kw-est__field-value"><span data-kw-ft-out>{{ est_default_ft }}</span> ft</span>
        </label>

        <div class="kw-est__togglegrid">
          <label class="kw-est__toggle">
            <input type="checkbox" data-kw-addon="smart" checked>
            <span>Smart App Control box</span>
          </label>
          <label class="kw-est__toggle">
            <input type="checkbox" data-kw-addon="soffit">
            <span>
              Power box
              <small class="kw-est__toggle-note">Required for installs over {{ section.settings.power_box_threshold_ft | default: 200 }} ft</small>
            </span>
          </label>
        </div>
      </div>

      <div class="kw-est__pane" data-kw-pane="solar" role="tabpanel" id="kw-est-{{ section.id }}-solar" aria-labelledby="kw-est-{{ section.id }}-tab-solar">
        <label class="kw-est__field">
          <span class="kw-est__field-label">Number of solar panels</span>
          <input type="range" min="0" max="40" step="2" value="16" data-kw-panels>
          <span class="kw-est__field-value"><span data-kw-panels-out>16</span> panel(s)</span>
        </label>

        <label class="kw-est__field">
          <span class="kw-est__field-label">Solar attic fans</span>
          <input type="range" min="0" max="4" step="1" value="1" data-kw-fans>
          <span class="kw-est__field-value"><span data-kw-fans-out>1</span> fan(s)</span>
        </label>

        <label class="kw-est__field">
          <span class="kw-est__field-label">Critter Guard — linear feet of panel edge</span>
          <input type="range" min="0" max="200" step="10" value="40" data-kw-guard>
          <span class="kw-est__field-value"><span data-kw-guard-out>40</span> ft</span>
        </label>

        <div class="kw-est__togglegrid">
          <label class="kw-est__toggle">
            <input type="checkbox" data-kw-addon="clean">
            <span>Solar panel cleaning</span>
          </label>
          <label class="kw-est__toggle">
            <input type="checkbox" data-kw-addon="removal">
            <span>Solar panel removal &amp; re-install</span>
          </label>
          <label class="kw-est__toggle">
            <input type="checkbox" data-kw-addon="service">
            <span>
              Service call
              <small class="kw-est__toggle-note">Flat ${{ section.settings.rate_service_call | default: 250 }}</small>
            </span>
          </label>
        </div>
      </div>

      <div class="kw-est__result">
        <div class="kw-est__result-label">Rough estimate</div>
        <div class="kw-est__result-range">
          <span data-kw-total>${{ est_display }}</span>
        </div>
        <p class="kw-est__disclaimer">{{ section.settings.disclaimer }}</p>
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_link }}" class="kw-btn" data-kw-est-cta>{{ section.settings.cta_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #kw-est-{{ section.id }} {
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-est-{{ section.id }} .kw-est__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }

  #kw-est-{{ section.id }} .kw-est__intro h2 {
    font-family: var(--kw-display);
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    margin-block: 0.4em 0.6em;
    max-width: 14ch;
  }

  #kw-est-{{ section.id }} .kw-est__lede {
    color: var(--kw-fg-dim);
    max-width: 38ch;
    line-height: 1.6;
  }

  #kw-est-{{ section.id }} .kw-est__panel {
    background: var(--kw-bg);
    border: 1px solid var(--kw-line);
    border-radius: 24px;
    padding: clamp(20px, 3vw, 32px);
  }

  #kw-est-{{ section.id }} .kw-est__tabs {
    display: inline-flex;
    background: var(--kw-bg-raised);
    border-radius: 100px;
    padding: 4px;
    margin-bottom: 1.8rem;
    gap: 4px;
  }

  #kw-est-{{ section.id }} .kw-est__tab {
    border: none;
    background: transparent;
    color: var(--kw-fg-dim);
    font-family: var(--kw-body);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.7em 1.2em;
    border-radius: 100px;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
  }

  #kw-est-{{ section.id }} .kw-est__tab.is-active {
    background: var(--kw-gold);
    color: var(--kw-bg);
  }

  #kw-est-{{ section.id }} .kw-est__pane {
    display: none;
  }

  #kw-est-{{ section.id }} .kw-est__pane.is-active {
    display: block;
  }

  #kw-est-{{ section.id }} .kw-est__field {
    display: block;
    margin-bottom: 1.4rem;
  }

  #kw-est-{{ section.id }} .kw-est__field-label {
    display: block;
    font-size: 0.85rem;
    color: var(--kw-fg-dim);
    margin-bottom: 0.6rem;
  }

  #kw-est-{{ section.id }} .kw-est__field-value {
    display: block;
    font-family: var(--kw-display);
    color: var(--kw-teal);
    margin-top: 0.4rem;
  }

  #kw-est-{{ section.id }} input[type='range'] {
    width: 100%;
    accent-color: var(--kw-gold);
    height: 4px;
  }

  #kw-est-{{ section.id }} .kw-est__togglegrid {
    display: grid;
    gap: 0.7rem;
    margin-bottom: 0.4rem;
  }

  #kw-est-{{ section.id }} .kw-est__toggle {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.9rem;
    color: var(--kw-fg);
  }

  #kw-est-{{ section.id }} .kw-est__toggle.is-locked {
    opacity: 0.65;
    cursor: default;
  }

  #kw-est-{{ section.id }} .kw-est__toggle input {
    accent-color: var(--kw-teal);
    width: 18px;
    height: 18px;
  }

  #kw-est-{{ section.id }} .kw-est__toggle-note {
    display: block;
    font-size: 0.75rem;
    color: var(--kw-fg-dim);
    margin-top: 0.2rem;
  }

  #kw-est-{{ section.id }} .kw-est__result {
    margin-top: 1.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--kw-line);
  }

  #kw-est-{{ section.id }} .kw-est__result-label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    color: var(--kw-fg-dim);
    margin-bottom: 0.4rem;
  }

  #kw-est-{{ section.id }} .kw-est__result-range {
    font-family: var(--kw-display);
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    color: var(--kw-gold);
    margin-bottom: 0.8rem;
    border-top: 1px solid var(--kw-line-bright);
    padding-top: 0.6rem;
  }

  #kw-est-{{ section.id }} .kw-est__disclaimer {
    color: var(--kw-fg-dim);
    font-size: 0.78rem;
    max-width: 42ch;
    margin: 0 0 1.4rem;
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    #kw-est-{{ section.id }} .kw-est__inner {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('kw-est-{{ section.id }}');
    if (!root) return;

    var RATE_FT = {{ section.settings.rate_ft | default: 27 }};
    var SMART_ADDON = {{ section.settings.rate_smart_addon | default: 500 }};
    var SOFFIT_FLAT = {{ section.settings.rate_power_box | default: 500 }};
    var POWER_BOX_MIN_FT = {{ section.settings.power_box_threshold_ft | default: 200 }};
    var FAN_RATE = {{ section.settings.rate_fan | default: 1200 }};
    var GUARD_FT_RATE = {{ section.settings.rate_guard_ft | default: 14 }};
    var PANEL_CLEAN_RATE = {{ section.settings.rate_clean_panel | default: 5 }};
    var REMOVAL_PER_PANEL_RATE = {{ section.settings.rate_removal_per_panel | default: 200 }};
    var SERVICE_CALL_RATE = {{ section.settings.rate_service_call | default: 250 }};

    var tabs = root.querySelectorAll('[data-kw-tab]');
    var panes = root.querySelectorAll('[data-kw-pane]');
    var activeTab = 'lighting';

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        activeTab = tab.dataset.kwTab;
        tabs.forEach(function (t) {
          t.classList.toggle('is-active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        panes.forEach(function (p) { p.classList.toggle('is-active', p.dataset.kwPane === activeTab); });
        compute();
      });
    });

    var ftInput = root.querySelector('[data-kw-ft]');
    var ftOut = root.querySelector('[data-kw-ft-out]');
    var panelsInput = root.querySelector('[data-kw-panels]');
    var panelsOut = root.querySelector('[data-kw-panels-out]');
    var fansInput = root.querySelector('[data-kw-fans]');
    var fansOut = root.querySelector('[data-kw-fans-out]');
    var guardInput = root.querySelector('[data-kw-guard]');
    var guardOut = root.querySelector('[data-kw-guard-out]');
    var addonSmart = root.querySelector('[data-kw-addon="smart"]');
    var addonSoffit = root.querySelector('[data-kw-addon="soffit"]');
    var addonClean = root.querySelector('[data-kw-addon="clean"]');
    var addonRemoval = root.querySelector('[data-kw-addon="removal"]');
    var addonService = root.querySelector('[data-kw-addon="service"]');
    var totalOut = root.querySelector('[data-kw-total]');

    function money(n) {
      return '$' + Math.round(n).toLocaleString('en-US');
    }

    function compute() {
      var total = 0;

      if (activeTab === 'lighting') {
        var ft = parseInt(ftInput.value, 10);
        ftOut.textContent = ft;
        total += ft * RATE_FT;
        if (addonSmart.checked) {
          total += SMART_ADDON;
        }

        // The toggle note already says the power box is required past the
        // threshold, so tick and lock it rather than quoting without it.
        var powerBoxRequired = ft > POWER_BOX_MIN_FT;
        if (powerBoxRequired) addonSoffit.checked = true;
        addonSoffit.disabled = powerBoxRequired;
        var soffitLabel = addonSoffit.closest('.kw-est__toggle');
        if (soffitLabel) soffitLabel.classList.toggle('is-locked', powerBoxRequired);

        if (addonSoffit.checked) {
          total += SOFFIT_FLAT;
        }
      } else {
        var panels = parseInt(panelsInput.value, 10);
        panelsOut.textContent = panels;

        var fans = parseInt(fansInput.value, 10);
        fansOut.textContent = fans;
        total += fans * FAN_RATE;

        var guardFt = parseInt(guardInput.value, 10);
        guardOut.textContent = guardFt;
        total += guardFt * GUARD_FT_RATE;

        if (addonClean.checked) {
          total += panels * PANEL_CLEAN_RATE;
        }
        if (addonRemoval.checked) {
          total += panels * REMOVAL_PER_PANEL_RATE;
        }
        if (addonService.checked) {
          total += SERVICE_CALL_RATE;
        }
      }

      totalOut.textContent = money(total);
      remember(total);
    }

    // Hand the configuration to the quote form (same page or the next one) through
    // sessionStorage, so the lead arrives with the roofline and price attached.
    function remember(total) {
      var summary, service;
      if (activeTab === 'lighting') {
        var parts = [ftInput.value + ' ft of roofline'];
        if (addonSmart.checked) parts.push('Smart App Control box');
        if (addonSoffit.checked) parts.push('power box');
        summary = money(total) + ' (lighting: ' + parts.join(', ') + ')';
        service = 'Permanent Lights';
      } else {
        var bits = [];
        if (+fansInput.value) bits.push(fansInput.value + ' attic fan(s)');
        if (+guardInput.value) bits.push(guardInput.value + ' ft Critter Guard');
        if (addonClean.checked) bits.push(panelsInput.value + ' panels cleaned');
        if (addonRemoval.checked) bits.push(panelsInput.value + ' panels removed & reinstalled');
        if (addonService.checked) bits.push('service call');
        summary = money(total) + ' (solar & attic: ' + (bits.join(', ') || 'nothing selected') + ')';
        service = +fansInput.value ? 'Attic Fan' : (+guardInput.value ? 'Critter Guard' : 'Solar Solutions');
      }
      root.dataset.kwSummary = summary;
      root.dataset.kwService = service;
    }

    var tracked = false;
    function used() {
      if (tracked) return;
      tracked = true;
      if (window.kwTrack) window.kwTrack('estimator_used', { estimate_type: activeTab });
    }

    var cta = root.querySelector('[data-kw-est-cta]');
    if (cta) {
      cta.addEventListener('click', function () {
        try {
          sessionStorage.setItem('kwEstimate', JSON.stringify({ summary: root.dataset.kwSummary, service: root.dataset.kwService }));
        } catch (e) {}
        var field = document.querySelector('[data-kw-estimate-field]');
        var note = document.querySelector('[data-kw-estimate-note]');
        if (field) field.value = root.dataset.kwSummary;
        if (note) {
          note.textContent = 'Your estimate: ' + root.dataset.kwSummary + '. We will confirm it on a free on-site visit.';
          note.hidden = false;
        }
        var select = document.querySelector('select[name="contact[Service type]"]');
        if (select && !select.value) select.value = root.dataset.kwService;
        if (window.kwTrack) window.kwTrack('estimator_quote_click', { estimate_type: activeTab });
      });
    }

    [ftInput, panelsInput, fansInput, guardInput, addonSmart, addonSoffit, addonClean, addonRemoval, addonService].forEach(function (el) {
      if (!el) return;
      el.addEventListener('input', compute);
      el.addEventListener('change', compute);
      el.addEventListener('input', used);
    });

    compute();
  })();
</script>

{% schema %}
{
  "name": "KW Estimator",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Rough price estimator" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See your ballpark, instantly." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Slide to your roofline or panel size for a rough range. Every quote is confirmed with a free on-site visit." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Rough estimate only, for budgeting purposes. All pricing is subject to adders based on site conditions (roof height, access, material). Final pricing is confirmed after a free on-site measurement." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Request this quote" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "header", "content": "Lighting rates" },
    { "type": "number", "id": "rate_ft", "label": "Per linear foot ($)", "default": 27 },
    { "type": "number", "id": "rate_smart_addon", "label": "Smart App Control box ($)", "default": 500 },
    { "type": "number", "id": "rate_power_box", "label": "Power box, flat ($)", "default": 500 },
    { "type": "number", "id": "power_box_threshold_ft", "label": "Power box required above (ft)", "default": 200 },
    { "type": "header", "content": "Solar & attic rates" },
    { "type": "number", "id": "rate_fan", "label": "Solar attic fan, each ($)", "default": 1200 },
    { "type": "number", "id": "rate_guard_ft", "label": "Critter Guard per foot ($)", "default": 14 },
    { "type": "number", "id": "rate_clean_panel", "label": "Panel cleaning per panel ($)", "default": 5 },
    { "type": "number", "id": "rate_removal_per_panel", "label": "Panel removal & re-install, per panel ($)", "default": 200 },
    { "type": "number", "id": "rate_service_call", "label": "Service call, flat ($)", "default": 250 }
  ],
  "presets": [{ "name": "KW Estimator" }]
}
{% endschema %}
