{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  KW FAQ — accordion built on native <details>/<summary>, so it is keyboard
  accessible and works with zero JavaScript.

  Emits FAQPage JSON-LD from the same blocks that render the visible copy, so the
  markup can never drift from what the user sees (a Google policy requirement).

  Honest expectation-setting: since Google's Aug-2023 change, FAQ RICH RESULTS are
  restricted to well-known government and health sites — a contractor will not get
  the expandable FAQ dropdowns in the SERP. The value here is real but different:
  it puts natural-language answers to high-intent long-tail questions ("how long do
  permanent lights last", "do solar attic fans actually work") into crawlable page
  copy, and it is the kind of Q&A content AI search and Google's AI Overviews pull
  from. The schema is kept because it is correct and costs nothing if the policy
  loosens again.
{%- endcomment -%}

<section class="kw-scope kw-section{% if section.settings.raised %} kw-section--raised{% endif %}" id="kw-faq-{{ section.id }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap kw-faq__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="kw-faq__heading kw-reveal">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="kw-faq__list">
      {% for block in section.blocks %}
        {% if block.settings.question != blank and block.settings.answer != blank %}
          <details
            class="kw-card kw-faq__item kw-reveal"
            style="transition-delay: {{ forloop.index0 | times: 0.06 }}s"
            {{ block.shopify_attributes }}
          >
            <summary class="kw-faq__q">
              <span class="kw-faq__q-text">{{ block.settings.question }}</span>
              <span class="kw-faq__chevron" aria-hidden="true"></span>
            </summary>
            <div class="kw-faq__a">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{%- liquid
  assign faq_blocks = ''
  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign faq_blocks = faq_blocks | append: 'x'
    endif
  endfor
-%}

{%- if faq_blocks != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign emitted = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- if emitted > 0 %},{% endif -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | strip | json }}
              }
            }
            {%- assign emitted = emitted | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<style>
  #kw-faq-{{ section.id }} {
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-faq-{{ section.id }} .kw-faq__heading {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    max-width: 22ch;
    margin-block: 0.4em 2.4rem;
  }

  #kw-faq-{{ section.id }} .kw-faq__list {
    display: grid;
    gap: 0.75rem;
    max-width: 68ch;
  }

  #kw-faq-{{ section.id }} .kw-faq__item {
    padding: 0;
    overflow: hidden;
  }

  #kw-faq-{{ section.id }} .kw-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    padding: 1.15rem 1.3rem;
    font-family: var(--kw-display);
    font-size: 1.02rem;
    color: var(--kw-fg);
  }

  #kw-faq-{{ section.id }} .kw-faq__q::-webkit-details-marker {
    display: none;
  }

  #kw-faq-{{ section.id }} .kw-faq__q:focus-visible {
    outline: 2px solid var(--kw-gold);
    outline-offset: -2px;
  }

  #kw-faq-{{ section.id }} .kw-faq__chevron {
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--kw-gold);
    border-bottom: 2px solid var(--kw-gold);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.22s ease;
  }

  #kw-faq-{{ section.id }} .kw-faq__item[open] .kw-faq__chevron {
    transform: rotate(-135deg) translate(-2px, -2px);
  }

  #kw-faq-{{ section.id }} .kw-faq__a {
    padding: 0 1.3rem 1.3rem;
    margin: 0;
    color: var(--kw-fg-dim);
    font-size: 0.94rem;
    line-height: 1.62;
  }

  #kw-faq-{{ section.id }} .kw-faq__a > :first-child {
    margin-top: 0;
  }

  #kw-faq-{{ section.id }} .kw-faq__a > :last-child {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    #kw-faq-{{ section.id }} .kw-faq__chevron {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "KW FAQ",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Common questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions homeowners ask us" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does an install take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most homes are done in a single day.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KW FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "How much does permanent lighting cost?", "answer": "<p>Permanent architectural lighting runs $27 per linear foot of roofline. A typical home with 150 to 250 feet of roofline lands between $4,000 and $6,750. Add-ons are flat rate: Smart App Control is $500 and a Power box is $500, required on any roofline over 200 feet. Run the numbers yourself on our estimate page — it uses our real rates, and no sales call is required.</p>" } },
        { "type": "faq", "settings": { "question": "Will permanent lights survive a hard winter?", "answer": "<p>Yes. The track and diodes we install are rated for real winters — freeze-thaw cycles, snow load on the eave, and full summer sun on a south-facing roofline. Craftsmanship and the lighting itself are both backed by a 10-year warranty.</p>" } },
        { "type": "faq", "settings": { "question": "How long does the install take?", "answer": "<p>Most single-family homes are finished in one day. Larger or multi-gable rooflines can run into a second day. We confirm the timeline with you before we start, and the crew cleans the site before leaving.</p>" } },
        { "type": "faq", "settings": { "question": "Can I see the lights before I commit?", "answer": "<p>Yes. The lighting page has live scene previews on an illustrated craftsman home so you can see warm white, holiday, game day and accent scenes before anything goes on your roof. Our gallery and testimonials pages show the same lighting on real finished installs.</p>" } },
        { "type": "faq", "settings": { "question": "Do solar attic fans actually work?", "answer": "<p>They do. Attics trap radiant heat through the summer, which pushes your cooling costs up and shortens shingle life. A solar attic fan runs off its own panel — no added power bill — and continuously pulls that hot air out. See the heat comparison on our solar page.</p>" } },
        { "type": "faq", "settings": { "question": "Do you install new solar panels?", "answer": "<p>No. Kilowash installs solar attic fans and cleans and maintains solar panel systems that are already on your roof. We do not sell or install new rooftop solar arrays. If your existing panels are underproducing, a cleaning is usually the cheapest fix worth trying first.</p>" } },
        { "type": "faq", "settings": { "question": "What areas do you serve?", "answer": "<p>We work across Utah, Ohio and West Virginia. In Utah that covers Salt Lake City, Sandy, Draper, South Jordan, West Jordan, Lehi, American Fork, Pleasant Grove, Orem, Provo, Ogden, Layton, Bountiful, Park City and the surrounding communities. In the Mid-Ohio Valley it covers Washington, Noble and Morgan Counties in Ohio and Wood County in West Virginia. Not sure if you are in range? Call or text and we will tell you straight.</p>" } },
        { "type": "faq", "settings": { "question": "Are you licensed and insured?", "answer": "<p>Yes — Kilowash is licensed and insured, and every install is done by our own crew. Every install is covered, and we carry a 10-year warranty on both the lighting and the workmanship.</p>" } }
      ]
    }
  ]
}
{% endschema %}
