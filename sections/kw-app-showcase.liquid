{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{% assign roofline = "60,265|92.5,250.42|125,235.83|157.5,221.25|190,206.67|222.5,192.08|255,177.5|287.5,162.92|320,148.33|352.5,133.75|385,119.17|417.5,104.58|450,90|482.5,104.58|515,119.17|547.5,133.75|580,148.33|612.5,162.92|645,177.5|677.5,192.08|710,206.67|742.5,221.25|775,235.83|807.5,250.42|840,265" | split: "|" %}

<section class="kw-scope kw-section{% if section.settings.raised %} kw-section--raised{% endif %}" id="kw-app-{{ section.id }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap kws__inner">
    <div class="kws__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="kws__heading kw-reveal">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="kws__lede kw-reveal">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="kws__showcase">
      <div class="kws__phone kw-reveal-scale">
        <div class="kws-phone__glow" data-kws-glow data-scene="gold"></div>
        <div class="kws-phone">
          <div class="kws-phone__bar">
            <span class="kws-phone__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
            </span>
            <span class="kws-phone__brand">Kilowash Control</span>
            <span class="kws-phone__status" aria-hidden="true"></span>
          </div>
          <div class="kws-phone__screen">
            <p class="kws-phone__label">Choose a scene</p>
            <div class="kws-scene-grid" data-kws-scenes>
              <button type="button" class="kws-scene is-active" data-kws-scene="gold" aria-pressed="true" style="--sw: var(--kws-gold);">
                <span class="kws-scene__icon"></span>
                <span>Solid Gold</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="ruby" aria-pressed="false" style="--sw: var(--kws-ruby);">
                <span class="kws-scene__icon"></span>
                <span>Ruby Red</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="ice" aria-pressed="false" style="--sw: var(--kws-ice);">
                <span class="kws-scene__icon"></span>
                <span>Ice Blue</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="emerald" aria-pressed="false" style="--sw: var(--kws-emerald);">
                <span class="kws-scene__icon"></span>
                <span>Emerald Green</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="sunset" aria-pressed="false" style="--sw: var(--kws-sunset);">
                <span class="kws-scene__icon"></span>
                <span>Sunset Orange</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="teal" aria-pressed="false" style="--sw: var(--kws-teal);">
                <span class="kws-scene__icon"></span>
                <span>Teal Glow</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="violet" aria-pressed="false" style="--sw: var(--kws-violet);">
                <span class="kws-scene__icon"></span>
                <span>Violet Party</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="holiday" aria-pressed="false" style="--sw: var(--kws-red);">
                <span class="kws-scene__icon kws-scene__icon--split"></span>
                <span>Holiday Classic</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="gameday" aria-pressed="false" style="--sw: var(--kws-blue);">
                <span class="kws-scene__icon kws-scene__icon--split2"></span>
                <span>Game Day</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="rainbow" aria-pressed="false" style="--sw: conic-gradient(from 0deg, #ff5f6d, #ffc371, #7bed9f, #70a1ff, #a55eea, #ff5f6d);">
                <span class="kws-scene__icon"></span>
                <span>16M Colors</span>
              </button>
            </div>
            <button type="button" class="kws-apply kw-btn" data-kws-apply>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
              Apply to home
            </button>
          </div>
        </div>
      </div>

      <div class="kws__house">
        <svg class="kws-house" data-kws-house data-scene="gold" viewBox="0 0 900 560" role="img" aria-label="Illustration of a luxury two-story house with animated color-changing roofline lights">
          <ellipse cx="450" cy="520" rx="380" ry="16" fill="rgba(0,0,0,0.35)" />

          <!-- main roof -->
          <polygon points="60,265 450,90 840,265" fill="#1c222b" />
          <polyline points="60,265 450,90 840,265" fill="none" stroke="#3a4656" stroke-width="3" />

          <!-- chimney -->
          <rect x="680" y="140" width="28" height="95" fill="#39424d" stroke="#171c22" stroke-width="2" />
          <rect x="674" y="133" width="40" height="11" fill="#171c22" />

          <!-- body -->
          <rect x="140" y="265" width="660" height="230" fill="#4b5563" />
          <rect x="130" y="495" width="680" height="14" fill="#333b45" />

          <!-- gable vent window -->
          <line x1="450" y1="115" x2="450" y2="150" stroke="#5b6472" stroke-width="3" />
          <circle class="kws-window" cx="450" cy="195" r="32" fill="#ffe9b3" stroke="#e8e4da" stroke-width="5" />
          <line x1="450" y1="163" x2="450" y2="227" stroke="#5b6472" stroke-width="3" />
          <line x1="418" y1="195" x2="482" y2="195" stroke="#5b6472" stroke-width="3" />

          <!-- dormers (4, symmetric pairs) -->
          {% assign dormers = "180,211|310,153|590,153|720,211" | split: "|" %}
          {% for d in dormers %}
            {% assign a = d | split: "," %}
            {% assign ax = a[0] %}
            {% assign ay = a[1] %}
            <polygon points="{{ ax | minus: 32 }},{{ ay | minus: 12 }} {{ ax }},{{ ay | minus: 46 }} {{ ax | plus: 32 }},{{ ay | minus: 12 }}" fill="#1c222b" stroke="#3a4656" stroke-width="2" />
            <rect x="{{ ax | minus: 26 }}" y="{{ ay | minus: 12 }}" width="52" height="50" fill="#e8e4da" />
            <rect class="kws-window" x="{{ ax | minus: 17 }}" y="{{ ay | minus: 4 }}" width="34" height="32" fill="#ffe9b3" stroke="#333b45" stroke-width="3" />
            <line x1="{{ ax }}" y1="{{ ay | minus: 4 }}" x2="{{ ax }}" y2="{{ ay | plus: 28 }}" stroke="#333b45" stroke-width="2" />
          {% endfor %}

          <!-- upper-floor windows with shutters -->
          <rect x="300" y="300" width="14" height="95" fill="#232a33" />
          <rect x="406" y="300" width="14" height="95" fill="#232a33" />
          <rect x="320" y="300" width="80" height="95" fill="#1c222b" stroke="#e8e4da" stroke-width="4" />
          <rect class="kws-window" x="328" y="308" width="64" height="79" fill="#ffe9b3" />
          <line x1="360" y1="308" x2="360" y2="387" stroke="#5b6472" stroke-width="3" />
          <line x1="328" y1="347" x2="392" y2="347" stroke="#5b6472" stroke-width="3" />

          <rect x="480" y="300" width="14" height="95" fill="#232a33" />
          <rect x="586" y="300" width="14" height="95" fill="#232a33" />
          <rect x="500" y="300" width="80" height="95" fill="#1c222b" stroke="#e8e4da" stroke-width="4" />
          <rect class="kws-window" x="508" y="308" width="64" height="79" fill="#ffe9b3" />
          <line x1="540" y1="308" x2="540" y2="387" stroke="#5b6472" stroke-width="3" />
          <line x1="508" y1="347" x2="572" y2="347" stroke="#5b6472" stroke-width="3" />

          <!-- large lower picture window -->
          <rect x="370" y="410" width="160" height="86" fill="#1c222b" stroke="#e8e4da" stroke-width="4" />
          <rect class="kws-window" x="378" y="418" width="144" height="70" fill="#ffe9b3" />
          <line x1="424" y1="418" x2="424" y2="488" stroke="#5b6472" stroke-width="3" />
          <line x1="476" y1="418" x2="476" y2="488" stroke="#5b6472" stroke-width="3" />
          <line x1="378" y1="453" x2="522" y2="453" stroke="#5b6472" stroke-width="3" />

          <!-- left wraparound porch -->
          <rect x="55" y="300" width="180" height="18" fill="#1c222b" />
          <rect x="55" y="318" width="180" height="6" fill="#171c22" />
          <circle class="kws-window" cx="145" cy="284" r="16" fill="#ffe9b3" stroke="#e8e4da" stroke-width="3" />
          <rect x="70" y="324" width="12" height="169" fill="#e8e4da" />
          <rect x="139" y="324" width="12" height="169" fill="#e8e4da" />
          <rect x="209" y="324" width="12" height="169" fill="#e8e4da" />
          <circle cx="145" cy="345" r="5" fill="#ffe9b3" />
          <rect x="135" y="380" width="70" height="113" fill="#232a33" stroke="#e8e4da" stroke-width="3" />
          <rect class="kws-window" x="153" y="394" width="32" height="36" fill="#ffe9b3" opacity="0.9" />
          <rect x="64" y="486" width="157" height="8" fill="#e8e4da" />
          <line x1="90" y1="494" x2="90" y2="486" stroke="#1c222b" stroke-width="2" />
          <line x1="105" y1="494" x2="105" y2="486" stroke="#1c222b" stroke-width="2" />
          <line x1="120" y1="494" x2="120" y2="486" stroke="#1c222b" stroke-width="2" />
          <line x1="165" y1="494" x2="165" y2="486" stroke="#1c222b" stroke-width="2" />
          <line x1="180" y1="494" x2="180" y2="486" stroke="#1c222b" stroke-width="2" />
          <line x1="195" y1="494" x2="195" y2="486" stroke="#1c222b" stroke-width="2" />
          <rect x="60" y="493" width="170" height="9" fill="#333b45" />

          <!-- garage -->
          <rect x="660" y="380" width="130" height="115" fill="#232a33" stroke="#e8e4da" stroke-width="3" />
          <line x1="660" y1="404" x2="790" y2="404" stroke="#171c22" stroke-width="2" />
          <line x1="660" y1="427" x2="790" y2="427" stroke="#171c22" stroke-width="2" />
          <line x1="660" y1="450" x2="790" y2="450" stroke="#171c22" stroke-width="2" />
          <line x1="660" y1="473" x2="790" y2="473" stroke="#171c22" stroke-width="2" />
          <rect class="kws-window" x="702" y="320" width="46" height="42" fill="#ffe9b3" stroke="#e8e4da" stroke-width="3" />

          <!-- hedges -->
          <ellipse cx="150" cy="504" rx="60" ry="14" fill="#2a5f40" />
          <ellipse cx="270" cy="506" rx="46" ry="13" fill="#2f6e4a" />
          <ellipse cx="630" cy="506" rx="46" ry="13" fill="#2f6e4a" />
          <ellipse cx="750" cy="504" rx="60" ry="14" fill="#2a5f40" />

          <!-- ground path lights -->
          <circle class="kws-window" cx="200" cy="510" r="3.5" fill="#ffe9b3" />
          <circle class="kws-window" cx="340" cy="512" r="3.5" fill="#ffe9b3" />
          <circle class="kws-window" cx="560" cy="512" r="3.5" fill="#ffe9b3" />
          <circle class="kws-window" cx="700" cy="510" r="3.5" fill="#ffe9b3" />

          <!-- fountain -->
          <ellipse cx="450" cy="536" rx="42" ry="10" fill="#8a8477" />
          <rect x="440" y="516" width="20" height="20" fill="#c9c3b4" />
          <ellipse cx="450" cy="516" rx="26" ry="7" fill="#c9c3b4" />
          <ellipse class="kws-window" cx="450" cy="513" rx="16" ry="4.5" fill="#bfe9ec" />
          <line x1="450" y1="513" x2="450" y2="500" stroke="#bfe9ec" stroke-width="2" opacity="0.7" />

          <!-- roofline light strand -->
          <polyline class="kws-wire" points="{{ roofline | join: ' ' }}" fill="none" stroke="#151a21" stroke-width="2" />
          {% for point in roofline %}
            {% assign coords = point | split: "," %}
            <circle class="kws-bulb" cx="{{ coords[0] }}" cy="{{ coords[1] }}" r="6.5" style="--i: {{ forloop.index0 }};"></circle>
          {% endfor %}
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  #kw-app-{{ section.id }} {
    --kws-gold: var(--kw-gold);
    --kws-teal: var(--kw-teal);
    --kws-violet: var(--kw-violet);
    --kws-red: #e5484d;
    --kws-green: #2f9e5c;
    --kws-blue: #3b82f6;
    --kws-white: #f5f5f0;
    --kws-ruby: #b91c3c;
    --kws-ice: #7dd3fc;
    --kws-emerald: #10b981;
    --kws-sunset: #fb923c;
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-app-{{ section.id }} .kws__intro {
    max-width: 60ch;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  #kw-app-{{ section.id }} .kws__heading {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    max-width: 22ch;
    margin-block: 0.4em 0.5em;
  }

  #kw-app-{{ section.id }} .kws__lede {
    color: var(--kw-fg-dim);
    max-width: 52ch;
    line-height: 1.6;
  }

  #kw-app-{{ section.id }} .kws__showcase {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }

  @media (max-width: 900px) {
    #kw-app-{{ section.id }} .kws__showcase {
      grid-template-columns: 1fr;
    }
    #kw-app-{{ section.id }} .kws__house {
      order: -1;
    }
  }

  /* phone mockup */
  #kw-app-{{ section.id }} .kws__phone {
    position: relative;
  }

  #kw-app-{{ section.id }} .kws-phone__glow {
    position: absolute;
    inset: -6% -14%;
    border-radius: 48px;
    filter: blur(48px);
    opacity: 0.4;
    z-index: 0;
    transition: background 0.6s ease;
    pointer-events: none;
  }

  #kw-app-{{ section.id }} .kws-phone {
    position: relative;
    z-index: 1;
    background: linear-gradient(165deg, var(--kw-bg-raised), var(--kw-bg));
    border: 1px solid var(--kw-line-bright);
    border-radius: 32px;
    padding: 14px;
    max-width: 320px;
    margin-inline: auto;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  #kw-app-{{ section.id }} .kws-phone__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem 0.95rem;
    font-family: var(--kw-display);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--kw-fg-dim);
    text-transform: uppercase;
  }

  #kw-app-{{ section.id }} .kws-phone__mark {
    display: inline-flex;
    color: var(--kw-gold);
  }

  #kw-app-{{ section.id }} .kws-phone__brand {
    flex: 1;
  }

  #kw-app-{{ section.id }} .kws-phone__status {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--kw-teal);
    box-shadow: 0 0 6px var(--kw-teal);
  }

  #kw-app-{{ section.id }} .kws-phone__screen {
    background: var(--kw-bg);
    border-radius: 22px;
    padding: 1.1rem;
    border: 1px solid var(--kw-line);
  }

  #kw-app-{{ section.id }} .kws-phone__label {
    font-family: var(--kw-display);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--kw-fg-dim);
    margin: 0 0 0.9rem;
  }

  #kw-app-{{ section.id }} .kws-scene-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  #kw-app-{{ section.id }} .kws-scene {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.03), transparent), var(--kw-bg-raised);
    border: 1px solid var(--kw-line);
    border-radius: 14px;
    padding: 0.75rem 0.4rem 0.6rem;
    color: var(--kw-fg-dim);
    font-size: 0.7rem;
    font-family: var(--kw-body);
    cursor: pointer;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }

  #kw-app-{{ section.id }} .kws-scene:hover {
    transform: translateY(-2px);
    color: var(--kw-fg);
  }

  #kw-app-{{ section.id }} .kws-scene__icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sw, var(--kw-gold));
    box-shadow: 0 0 10px var(--sw, var(--kw-gold)), inset 0 1px 2px rgba(255, 255, 255, 0.5);
  }

  #kw-app-{{ section.id }} .kws-scene__icon--split {
    background: conic-gradient(var(--kws-red) 0deg 120deg, var(--kws-white) 120deg 240deg, var(--kws-green) 240deg 360deg);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.35);
  }

  #kw-app-{{ section.id }} .kws-scene__icon--split2 {
    background: conic-gradient(var(--kws-blue) 0deg 180deg, var(--kws-red) 180deg 360deg);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
  }

  #kw-app-{{ section.id }} .kws-scene.is-active {
    border-color: var(--kw-gold);
    color: var(--kw-fg);
    box-shadow: 0 0 0 1px var(--kw-gold), 0 0 18px rgba(245, 185, 66, 0.35);
  }

  #kw-app-{{ section.id }} .kws-apply {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    text-align: center;
    transition: box-shadow 0.3s ease, transform 0.15s ease;
  }

  #kw-app-{{ section.id }} .kws-apply.is-applied {
    animation: kws-apply-pulse 0.7s ease;
  }

  @keyframes kws-apply-pulse {
    0% { box-shadow: 0 0 0 0 rgba(245, 185, 66, 0.6); }
    70% { box-shadow: 0 0 0 16px rgba(245, 185, 66, 0); }
    100% { box-shadow: 0 0 0 0 rgba(245, 185, 66, 0); }
  }

  /* ambient glow per scene */
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="gold"] { background: var(--kws-gold); }
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="ruby"] { background: var(--kws-ruby); }
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="ice"] { background: var(--kws-ice); }
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="emerald"] { background: var(--kws-emerald); }
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="sunset"] { background: var(--kws-sunset); }
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="teal"] { background: var(--kws-teal); }
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="violet"] { background: var(--kws-violet); }
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="holiday"] { background: var(--kws-red); }
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="gameday"] { background: var(--kws-blue); }
  #kw-app-{{ section.id }} .kws-phone__glow[data-scene="rainbow"] { background: conic-gradient(from 0deg, #ff5f6d, #ffc371, #7bed9f, #70a1ff, #a55eea, #ff5f6d); }

  /* house */
  #kw-app-{{ section.id }} .kws__house {
    width: 100%;
  }

  #kw-app-{{ section.id }} .kws-house {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  #kw-app-{{ section.id }} .kws-window {
    filter: drop-shadow(0 0 10px rgba(255, 220, 140, 0.4));
  }

  #kw-app-{{ section.id }} .kws-bulb {
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.4));
    transform-box: fill-box;
    transform-origin: center;
  }

  /* base (no-motion-safe) fill per scene */
  #kw-app-{{ section.id }} .kws-house[data-scene="gold"] .kws-bulb { fill: var(--kws-gold); }
  #kw-app-{{ section.id }} .kws-house[data-scene="ruby"] .kws-bulb { fill: var(--kws-ruby); }
  #kw-app-{{ section.id }} .kws-house[data-scene="ice"] .kws-bulb { fill: var(--kws-ice); }
  #kw-app-{{ section.id }} .kws-house[data-scene="emerald"] .kws-bulb { fill: var(--kws-emerald); }
  #kw-app-{{ section.id }} .kws-house[data-scene="sunset"] .kws-bulb { fill: var(--kws-sunset); }
  #kw-app-{{ section.id }} .kws-house[data-scene="teal"] .kws-bulb { fill: var(--kws-teal); }
  #kw-app-{{ section.id }} .kws-house[data-scene="violet"] .kws-bulb { fill: var(--kws-violet); }
  #kw-app-{{ section.id }} .kws-house[data-scene="holiday"] .kws-bulb { fill: var(--kws-red); }
  #kw-app-{{ section.id }} .kws-house[data-scene="gameday"] .kws-bulb { fill: var(--kws-blue); }
  #kw-app-{{ section.id }} .kws-house[data-scene="rainbow"] .kws-bulb { fill: hsl(calc(var(--i) * 14.4deg), 90%, 60%); }

  @media (prefers-reduced-motion: no-preference) {
    #kw-app-{{ section.id }} .kws-house[data-scene="gold"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="ruby"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="ice"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="emerald"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="sunset"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="teal"] .kws-bulb {
      animation: kws-twinkle 2.4s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.12s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="violet"] .kws-bulb {
      animation: kws-twinkle 1.5s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.09s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="holiday"] .kws-bulb {
      animation: kws-holiday-chase 1.8s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.15s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="gameday"] .kws-bulb {
      animation: kws-gameday-chase 1.1s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.1s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="rainbow"] .kws-bulb {
      animation: kws-rainbow-cycle 4s linear infinite;
      animation-delay: calc(var(--i) * -0.16s);
    }
  }

  @keyframes kws-twinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.82); }
  }

  @keyframes kws-holiday-chase {
    0%, 32% { fill: var(--kws-red); }
    33%, 65% { fill: var(--kws-white); }
    66%, 100% { fill: var(--kws-green); }
  }

  @keyframes kws-gameday-chase {
    0%, 49% { fill: var(--kws-blue); }
    50%, 100% { fill: var(--kws-red); }
  }

  @keyframes kws-rainbow-cycle {
    from { filter: hue-rotate(0deg) drop-shadow(0 0 6px rgba(255, 255, 255, 0.4)); }
    to { filter: hue-rotate(360deg) drop-shadow(0 0 6px rgba(255, 255, 255, 0.4)); }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('kw-app-{{ section.id }}');
    if (!root) return;

    var house = root.querySelector('[data-kws-house]');
    var glow = root.querySelector('[data-kws-glow]');
    var buttons = root.querySelectorAll('[data-kws-scene]');
    var applyBtn = root.querySelector('[data-kws-apply]');
    var order = ['gold', 'ruby', 'ice', 'emerald', 'sunset', 'teal', 'violet', 'holiday', 'gameday', 'rainbow'];
    var index = 0;
    var timer = null;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setScene(scene) {
      house.setAttribute('data-scene', scene);
      if (glow) glow.setAttribute('data-scene', scene);
      buttons.forEach(function (btn) {
        var active = btn.dataset.kwsScene === scene;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      index = order.indexOf(scene);
      if (index === -1) index = 0;
    }

    function advance() {
      index = (index + 1) % order.length;
      setScene(order[index]);
    }

    function startAutoplay() {
      if (reduceMotion) return;
      stopAutoplay();
      timer = window.setInterval(advance, 4500);
    }

    function stopAutoplay() {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        setScene(btn.dataset.kwsScene);
        startAutoplay();
      });
    });

    if (applyBtn) {
      applyBtn.addEventListener('click', function () {
        applyBtn.classList.remove('is-applied');
        void applyBtn.offsetWidth;
        applyBtn.classList.add('is-applied');
        window.setTimeout(function () { applyBtn.classList.remove('is-applied'); }, 800);
      });
    }

    setScene('gold');
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "KW App showcase",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "One app. Every color." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "16 million colors, controlled from your pocket." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick a preset scene or build your own — tap Apply and your roofline updates in real time." }
  ],
  "presets": [{ "name": "KW App showcase" }]
}
{% endschema %}
