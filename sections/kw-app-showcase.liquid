{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{% assign roofline = "110,265|133.8,251.9|157.5,238.8|181.3,225.6|205,212.5|228.8,199.4|252.5,186.3|276.3,173.1|300,160|323.8,146.9|347.5,133.8|371.3,120.6|400,110|423.8,120.6|447.5,133.8|471.3,146.9|495,160|518.8,173.1|542.5,186.3|566.3,199.4|590,212.5|613.8,225.6|637.5,238.8|661.3,251.9|690,265" | split: "|" %}

<section class="kw-scope kw-section{% if section.settings.raised %} kw-section--raised{% endif %}" id="kw-app-{{ section.id }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap kws__inner">
    <div class="kws__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="kws__heading kw-reveal">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="kws__lede kw-reveal">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="kws__showcase">
      <div class="kws__phone kw-reveal-scale">
        <div class="kws-phone">
          <div class="kws-phone__bar">
            <span class="kws-phone__dot"></span>
            <span>Kilowash Control</span>
          </div>
          <div class="kws-phone__screen">
            <p class="kws-phone__label">Choose a scene</p>
            <div class="kws-scene-grid" data-kws-scenes>
              <button type="button" class="kws-scene is-active" data-kws-scene="gold" aria-pressed="true">
                <span class="kws-scene__icon">💡</span>
                <span>Solid Gold</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="teal" aria-pressed="false">
                <span class="kws-scene__icon">🌊</span>
                <span>Teal Glow</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="violet" aria-pressed="false">
                <span class="kws-scene__icon">🎉</span>
                <span>Violet Party</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="holiday" aria-pressed="false">
                <span class="kws-scene__icon">🎄</span>
                <span>Holiday Classic</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="gameday" aria-pressed="false">
                <span class="kws-scene__icon">🏈</span>
                <span>Game Day</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="rainbow" aria-pressed="false">
                <span class="kws-scene__icon">🌈</span>
                <span>16M Colors</span>
              </button>
            </div>
            <button type="button" class="kws-apply kw-btn" data-kws-apply>Apply to home</button>
          </div>
        </div>
      </div>

      <div class="kws__house">
        <svg class="kws-house" data-kws-house data-scene="gold" viewBox="0 0 800 620" role="img" aria-label="Illustration of a house with animated color-changing roofline lights">
          <ellipse cx="400" cy="580" rx="320" ry="18" fill="rgba(0,0,0,0.35)" />

          <!-- roof -->
          <polygon points="110,265 400,110 690,265" fill="#20262f" />
          <polyline points="110,265 400,110 690,265" fill="none" stroke="#3a4656" stroke-width="3" />

          <!-- chimney -->
          <rect x="560" y="140" width="34" height="90" fill="#20262f" stroke="#151a21" stroke-width="2" />
          <rect x="553" y="133" width="48" height="12" fill="#171c22" />

          <!-- body -->
          <rect x="170" y="265" width="460" height="295" fill="#2b3340" />
          <rect x="160" y="550" width="480" height="16" fill="#1c222b" />

          <!-- round gable window -->
          <circle class="kws-window" cx="400" cy="195" r="34" fill="#ffe9b3" stroke="#3a4656" stroke-width="4" />
          <line x1="400" y1="161" x2="400" y2="229" stroke="#3a4656" stroke-width="3" />
          <line x1="366" y1="195" x2="434" y2="195" stroke="#3a4656" stroke-width="3" />

          <!-- left tall window -->
          <rect x="210" y="330" width="100" height="160" fill="#1c222b" stroke="#3a4656" stroke-width="4" />
          <rect class="kws-window" x="218" y="338" width="84" height="144" fill="#ffe9b3" />
          <line x1="260" y1="338" x2="260" y2="482" stroke="#3a4656" stroke-width="3" />
          <line x1="218" y1="410" x2="302" y2="410" stroke="#3a4656" stroke-width="3" />

          <!-- door -->
          <rect x="350" y="400" width="100" height="160" fill="#151a21" stroke="#3a4656" stroke-width="4" />
          <rect class="kws-window" x="380" y="420" width="40" height="50" fill="#ffe9b3" opacity="0.9" />
          <circle cx="435" cy="485" r="4" fill="#f5b942" />

          <!-- porch roof -->
          <rect x="480" y="340" width="170" height="20" fill="#20262f" />
          <rect x="480" y="356" width="170" height="6" fill="#171c22" />

          <!-- porch columns -->
          <rect x="495" y="360" width="14" height="190" fill="#3a4656" />
          <rect x="565" y="360" width="14" height="190" fill="#3a4656" />
          <rect x="630" y="360" width="14" height="190" fill="#3a4656" />

          <!-- porch windows -->
          <rect x="515" y="380" width="44" height="90" fill="#1c222b" stroke="#3a4656" stroke-width="3" />
          <rect class="kws-window" x="520" y="385" width="34" height="80" fill="#ffe9b3" />
          <rect x="580" y="380" width="44" height="90" fill="#1c222b" stroke="#3a4656" stroke-width="3" />
          <rect class="kws-window" x="585" y="385" width="34" height="80" fill="#ffe9b3" />

          <!-- porch floor + railing -->
          <rect x="485" y="550" width="160" height="10" fill="#20262f" />
          <rect x="495" y="540" width="149" height="10" fill="#3a4656" />
          <line x1="502" y1="542" x2="502" y2="550" stroke="#20262f" stroke-width="3" />
          <line x1="517" y1="542" x2="517" y2="550" stroke="#20262f" stroke-width="3" />
          <line x1="532" y1="542" x2="532" y2="550" stroke="#20262f" stroke-width="3" />
          <line x1="547" y1="542" x2="547" y2="550" stroke="#20262f" stroke-width="3" />
          <line x1="562" y1="542" x2="562" y2="550" stroke="#20262f" stroke-width="3" />
          <line x1="577" y1="542" x2="577" y2="550" stroke="#20262f" stroke-width="3" />
          <line x1="592" y1="542" x2="592" y2="550" stroke="#20262f" stroke-width="3" />
          <line x1="607" y1="542" x2="607" y2="550" stroke="#20262f" stroke-width="3" />
          <line x1="622" y1="542" x2="622" y2="550" stroke="#20262f" stroke-width="3" />
          <line x1="637" y1="542" x2="637" y2="550" stroke="#20262f" stroke-width="3" />

          <!-- steps -->
          <polygon points="540,560 590,560 600,580 530,580" fill="#171c22" />

          <!-- roofline light strand -->
          <polyline class="kws-wire" points="{{ roofline | join: ' ' }}" fill="none" stroke="#151a21" stroke-width="2" />
          {% for point in roofline %}
            {% assign coords = point | split: "," %}
            <circle class="kws-bulb" cx="{{ coords[0] }}" cy="{{ coords[1] }}" r="6.5" style="--i: {{ forloop.index0 }};"></circle>
          {% endfor %}
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  #kw-app-{{ section.id }} {
    --kws-gold: var(--kw-gold);
    --kws-teal: var(--kw-teal);
    --kws-violet: var(--kw-violet);
    --kws-red: #e5484d;
    --kws-green: #2f9e5c;
    --kws-blue: #3b82f6;
    --kws-white: #f5f5f0;
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-app-{{ section.id }} .kws__intro {
    max-width: 60ch;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  #kw-app-{{ section.id }} .kws__heading {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    max-width: 22ch;
    margin-block: 0.4em 0.5em;
  }

  #kw-app-{{ section.id }} .kws__lede {
    color: var(--kw-fg-dim);
    max-width: 52ch;
    line-height: 1.6;
  }

  #kw-app-{{ section.id }} .kws__showcase {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }

  @media (max-width: 900px) {
    #kw-app-{{ section.id }} .kws__showcase {
      grid-template-columns: 1fr;
    }
    #kw-app-{{ section.id }} .kws__house {
      order: -1;
    }
  }

  /* phone mockup */
  #kw-app-{{ section.id }} .kws-phone {
    background: var(--kw-bg-raised);
    border: 1px solid var(--kw-line-bright);
    border-radius: 32px;
    padding: 14px;
    max-width: 320px;
    margin-inline: auto;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }

  #kw-app-{{ section.id }} .kws-phone__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--kw-fg-dim);
    text-transform: uppercase;
  }

  #kw-app-{{ section.id }} .kws-phone__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--kw-teal);
    box-shadow: 0 0 6px var(--kw-teal);
  }

  #kw-app-{{ section.id }} .kws-phone__screen {
    background: var(--kw-bg);
    border-radius: 22px;
    padding: 1.1rem;
    border: 1px solid var(--kw-line);
  }

  #kw-app-{{ section.id }} .kws-phone__label {
    font-family: var(--kw-display);
    font-size: 0.85rem;
    color: var(--kw-fg);
    margin: 0 0 0.8rem;
  }

  #kw-app-{{ section.id }} .kws-scene-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  #kw-app-{{ section.id }} .kws-scene {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    background: var(--kw-bg-raised);
    border: 1px solid var(--kw-line);
    border-radius: 14px;
    padding: 0.7rem 0.4rem;
    color: var(--kw-fg-dim);
    font-size: 0.72rem;
    font-family: var(--kw-body);
    cursor: pointer;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }

  #kw-app-{{ section.id }} .kws-scene:hover {
    transform: translateY(-2px);
    color: var(--kw-fg);
  }

  #kw-app-{{ section.id }} .kws-scene__icon {
    font-size: 1.3rem;
    line-height: 1;
  }

  #kw-app-{{ section.id }} .kws-scene.is-active {
    border-color: var(--kw-gold);
    color: var(--kw-fg);
    box-shadow: 0 0 0 1px var(--kw-gold), 0 0 18px rgba(245, 185, 66, 0.35);
  }

  #kw-app-{{ section.id }} .kws-apply {
    display: block;
    width: 100%;
    text-align: center;
    transition: box-shadow 0.3s ease, transform 0.15s ease;
  }

  #kw-app-{{ section.id }} .kws-apply.is-applied {
    animation: kws-apply-pulse 0.7s ease;
  }

  @keyframes kws-apply-pulse {
    0% { box-shadow: 0 0 0 0 rgba(245, 185, 66, 0.6); }
    70% { box-shadow: 0 0 0 16px rgba(245, 185, 66, 0); }
    100% { box-shadow: 0 0 0 0 rgba(245, 185, 66, 0); }
  }

  /* house */
  #kw-app-{{ section.id }} .kws__house {
    width: 100%;
  }

  #kw-app-{{ section.id }} .kws-house {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  #kw-app-{{ section.id }} .kws-window {
    filter: drop-shadow(0 0 10px rgba(255, 220, 140, 0.4));
  }

  #kw-app-{{ section.id }} .kws-bulb {
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.4));
  }

  /* base (no-motion-safe) fill per scene */
  #kw-app-{{ section.id }} .kws-house[data-scene="gold"] .kws-bulb { fill: var(--kws-gold); }
  #kw-app-{{ section.id }} .kws-house[data-scene="teal"] .kws-bulb { fill: var(--kws-teal); }
  #kw-app-{{ section.id }} .kws-house[data-scene="violet"] .kws-bulb { fill: var(--kws-violet); }
  #kw-app-{{ section.id }} .kws-house[data-scene="holiday"] .kws-bulb { fill: var(--kws-red); }
  #kw-app-{{ section.id }} .kws-house[data-scene="gameday"] .kws-bulb { fill: var(--kws-blue); }
  #kw-app-{{ section.id }} .kws-house[data-scene="rainbow"] .kws-bulb { fill: hsl(calc(var(--i) * 14.4deg), 90%, 60%); }

  @media (prefers-reduced-motion: no-preference) {
    #kw-app-{{ section.id }} .kws-house[data-scene="gold"] .kws-bulb {
      animation: kws-twinkle 2.4s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.12s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="teal"] .kws-bulb {
      animation: kws-twinkle 2.4s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.12s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="violet"] .kws-bulb {
      animation: kws-twinkle 1.5s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.09s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="holiday"] .kws-bulb {
      animation: kws-holiday-chase 1.8s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.15s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="gameday"] .kws-bulb {
      animation: kws-gameday-chase 1.1s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.1s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="rainbow"] .kws-bulb {
      animation: kws-rainbow-cycle 4s linear infinite;
      animation-delay: calc(var(--i) * -0.16s);
    }
  }

  @keyframes kws-twinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.82); }
  }

  @keyframes kws-holiday-chase {
    0%, 32% { fill: var(--kws-red); }
    33%, 65% { fill: var(--kws-white); }
    66%, 100% { fill: var(--kws-green); }
  }

  @keyframes kws-gameday-chase {
    0%, 49% { fill: var(--kws-blue); }
    50%, 100% { fill: var(--kws-red); }
  }

  @keyframes kws-rainbow-cycle {
    from { filter: hue-rotate(0deg) drop-shadow(0 0 6px rgba(255, 255, 255, 0.4)); }
    to { filter: hue-rotate(360deg) drop-shadow(0 0 6px rgba(255, 255, 255, 0.4)); }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('kw-app-{{ section.id }}');
    if (!root) return;

    var house = root.querySelector('[data-kws-house]');
    var buttons = root.querySelectorAll('[data-kws-scene]');
    var applyBtn = root.querySelector('[data-kws-apply]');
    var order = ['gold', 'teal', 'violet', 'holiday', 'gameday', 'rainbow'];
    var index = 0;
    var timer = null;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setScene(scene) {
      house.setAttribute('data-scene', scene);
      buttons.forEach(function (btn) {
        var active = btn.dataset.kwsScene === scene;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      index = order.indexOf(scene);
      if (index === -1) index = 0;
    }

    function advance() {
      index = (index + 1) % order.length;
      setScene(order[index]);
    }

    function startAutoplay() {
      if (reduceMotion) return;
      stopAutoplay();
      timer = window.setInterval(advance, 4500);
    }

    function stopAutoplay() {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        setScene(btn.dataset.kwsScene);
        startAutoplay();
      });
    });

    if (applyBtn) {
      applyBtn.addEventListener('click', function () {
        applyBtn.classList.remove('is-applied');
        void applyBtn.offsetWidth;
        applyBtn.classList.add('is-applied');
        window.setTimeout(function () { applyBtn.classList.remove('is-applied'); }, 800);
      });
    }

    setScene('gold');
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "KW App showcase",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "One app. Every color." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "16 million colors, controlled from your pocket." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick a preset scene or build your own — tap Apply and your roofline updates in real time." }
  ],
  "presets": [{ "name": "KW App showcase" }]
}
{% endschema %}
