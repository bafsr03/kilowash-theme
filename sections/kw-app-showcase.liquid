{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{% assign roofline = "110,265|133.8,251.9|157.5,238.8|181.3,225.6|205,212.5|228.8,199.4|252.5,186.3|276.3,173.1|300,160|323.8,146.9|347.5,133.8|371.3,120.6|400,110|423.8,120.6|447.5,133.8|471.3,146.9|495,160|518.8,173.1|542.5,186.3|566.3,199.4|590,212.5|613.8,225.6|637.5,238.8|661.3,251.9|690,265" | split: "|" %}

<section class="kw-scope kw-section{% if section.settings.raised %} kw-section--raised{% endif %}" id="kw-app-{{ section.id }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap kws__inner">
    <div class="kws__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="kws__heading kw-reveal">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="kws__lede kw-reveal">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="kws__showcase">
      <div class="kws__phone kw-reveal-scale">
        <div class="kws-phone">
          <div class="kws-phone__bar">
            <span class="kws-phone__dot"></span>
            <span>Kilowash Control</span>
          </div>
          <div class="kws-phone__screen">
            <p class="kws-phone__label">Choose a scene</p>
            <div class="kws-scene-grid" data-kws-scenes>
              <button type="button" class="kws-scene is-active" data-kws-scene="gold" aria-pressed="true">
                <span class="kws-scene__icon">💡</span>
                <span>Solid Gold</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="ruby" aria-pressed="false">
                <span class="kws-scene__icon">🔴</span>
                <span>Ruby Red</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="ice" aria-pressed="false">
                <span class="kws-scene__icon">❄️</span>
                <span>Ice Blue</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="emerald" aria-pressed="false">
                <span class="kws-scene__icon">🟢</span>
                <span>Emerald Green</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="sunset" aria-pressed="false">
                <span class="kws-scene__icon">🌅</span>
                <span>Sunset Orange</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="teal" aria-pressed="false">
                <span class="kws-scene__icon">🌊</span>
                <span>Teal Glow</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="violet" aria-pressed="false">
                <span class="kws-scene__icon">🎉</span>
                <span>Violet Party</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="holiday" aria-pressed="false">
                <span class="kws-scene__icon">🎄</span>
                <span>Holiday Classic</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="gameday" aria-pressed="false">
                <span class="kws-scene__icon">🏈</span>
                <span>Game Day</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="rainbow" aria-pressed="false">
                <span class="kws-scene__icon">🌈</span>
                <span>16M Colors</span>
              </button>
            </div>
            <button type="button" class="kws-apply kw-btn" data-kws-apply>Apply to home</button>
          </div>
        </div>
      </div>

