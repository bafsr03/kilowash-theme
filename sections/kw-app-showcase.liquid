  #kw-app-{{ section.id }} .kws-phone__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem 0.95rem;
    font-family: var(--kw-display);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--kw-fg-dim);
    text-transform: uppercase;
  }

  #kw-app-{{ section.id }} .kws-phone__mark {
    display: inline-flex;
    color: var(--kw-gold);
  }

  #kw-app-{{ section.id }} .kws-phone__brand {
    flex: 1;
  }

  #kw-app-{{ section.id }} .kws-phone__status {
    width: 6px;
    height: 6px;
    border-radius: 50%;
