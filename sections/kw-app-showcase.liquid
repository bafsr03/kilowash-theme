<style>
  #kw-app-{{ section.id }} {
    --kws-gold: var(--kw-gold);
    --kws-teal: var(--kw-teal);
    --kws-violet: var(--kw-violet);
    --kws-red: #e5484d;
    --kws-green: #2f9e5c;
    --kws-blue: #3b82f6;
    --kws-white: #f5f5f0;
    --kws-ruby: #b91c3c;
    --kws-ice: #7dd3fc;
    --kws-emerald: #10b981;
    --kws-sunset: #fb923c;
    --kws-pastel-pink: #f9a8d4;
    --kws-pastel-mint: #86efac;
    --kws-pastel-lavender: #c4b5fd;
    --kws-pastel-yellow: #fde68a;
    --kws-party-pink: #ec4899;
    --kws-party-cyan: #22d3ee;
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-app-{{ section.id }} .kws__intro {
    max-width: 60ch;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  #kw-app-{{ section.id }} .kws__heading {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    max-width: 22ch;
    margin-block: 0.4em 0.5em;
  }

  #kw-app-{{ section.id }} .kws__lede {
    color: var(--kw-fg-dim);
    max-width: 52ch;
    line-height: 1.6;
  }

  #kw-app-{{ section.id }} .kws__showcase {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }

  @media (max-width: 900px) {
    #kw-app-{{ section.id }} .kws__showcase {
      grid-template-columns: 1fr;
    }
    #kw-app-{{ section.id }} .kws__house {
      order: -1;
    }
    #kw-app-{{ section.id }} .kws-scene__icon {
      box-shadow: 0 0 16px 2px var(--sw, var(--kw-gold)), inset 0 1px 2px rgba(255, 255, 255, 0.5);
    }
  }

  /* phone mockup */
  #kw-app-{{ section.id }} .kws-phone {
    background: linear-gradient(165deg, var(--kw-bg-raised), var(--kw-bg));
