  #kw-app-{{ section.id }} .kws-scene__icon--split3 {
    background: conic-gradient(var(--kws-red) 0deg 120deg, var(--kws-white) 120deg 240deg, var(--kws-blue) 240deg 360deg);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.35);
