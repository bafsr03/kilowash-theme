  #kw-app-{{ section.id }} .kws-scene-active {
    text-align: center;
    font-family: var(--kw-display);
    font-size: 0.85rem;
    color: var(--kw-fg);
    margin: 0 0 1rem;
  }

  #kw-app-{{ section.id }} .kws-apply {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    text-align: center;
    transition: box-shadow 0.3s ease, transform 0.15s ease;
