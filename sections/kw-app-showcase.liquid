  #kw-app-{{ section.id }} .kws-scene__icon--split6 {
    background: conic-gradient(var(--kws-party-pink) 0deg 90deg, var(--kws-party-cyan) 90deg 180deg, var(--kws-gold) 180deg 270deg, var(--kws-violet) 270deg 360deg);
