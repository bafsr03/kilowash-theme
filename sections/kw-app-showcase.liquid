<section class="kw-scope kw-section{% if section.settings.raised %} kw-section--raised{% endif %}" id="kw-app-{{ section.id }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap kws__inner">
    <div class="kws__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="kws__heading kw-reveal">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="kws__lede kw-reveal">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="kws__showcase">
      <div class="kws__phone kw-reveal-scale">
        <div class="kws-phone">
          <div class="kws-phone__bar">
            <span class="kws-phone__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
            </span>
            <span class="kws-phone__brand">Kilowash Control</span>
            <span class="kws-phone__status" aria-hidden="true"></span>
          </div>
          <div class="kws-phone__screen">
            <p class="kws-phone__label">Choose a scene</p>
            <div class="kws-scene-grid" data-kws-scenes>
              <button type="button" class="kws-scene is-active" data-kws-scene="gold" aria-pressed="true" aria-label="Solid Gold" style="--sw: var(--kws-gold);">
                <span class="kws-scene__icon"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="ruby" aria-pressed="false" aria-label="Ruby Red" style="--sw: var(--kws-ruby);">
                <span class="kws-scene__icon"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="ice" aria-pressed="false" aria-label="Ice Blue" style="--sw: var(--kws-ice);">
                <span class="kws-scene__icon"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="emerald" aria-pressed="false" aria-label="Emerald Green" style="--sw: var(--kws-emerald);">
                <span class="kws-scene__icon"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="sunset" aria-pressed="false" aria-label="Sunset Orange" style="--sw: var(--kws-sunset);">
                <span class="kws-scene__icon"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="teal" aria-pressed="false" aria-label="Teal Glow" style="--sw: var(--kws-teal);">
                <span class="kws-scene__icon"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="violet" aria-pressed="false" aria-label="Violet Party" style="--sw: var(--kws-violet);">
                <span class="kws-scene__icon"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="holiday" aria-pressed="false" aria-label="Holiday Classic" style="--sw: var(--kws-red);">
                <span class="kws-scene__icon kws-scene__icon--split"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="gameday" aria-pressed="false" aria-label="Game Day" style="--sw: var(--kws-blue);">
                <span class="kws-scene__icon kws-scene__icon--split2"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="rainbow" aria-pressed="false" aria-label="16M Colors" style="--sw: conic-gradient(from 0deg, #ff5f6d, #ffc371, #7bed9f, #70a1ff, #a55eea, #ff5f6d);">
                <span class="kws-scene__icon"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="america" aria-pressed="false" aria-label="America" style="--sw: var(--kws-red);">
                <span class="kws-scene__icon kws-scene__icon--split3"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="halloween" aria-pressed="false" aria-label="Halloween" style="--sw: var(--kws-sunset);">
                <span class="kws-scene__icon kws-scene__icon--split4"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="easter" aria-pressed="false" aria-label="Easter" style="--sw: var(--kws-pastel-pink);">
                <span class="kws-scene__icon kws-scene__icon--split5"></span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="birthday" aria-pressed="false" aria-label="Birthday" style="--sw: var(--kws-party-pink);">
                <span class="kws-scene__icon kws-scene__icon--split6"></span>
              </button>
            </div>
            <p class="kws-scene-active" data-kws-scene-name>Solid Gold</p>
