{{ 'kw-theme.css' | asset_url | stylesheet_tag }}

{% assign strip_main = "100,230|130,215.42|160,200.83|190,186.25|220,171.67|250,157.08|280,142.5|310,127.92|340,113.33|370,98.75|400,84.17|430,69.58|460,55|485,72.92|510,90.83|535,108.75|560,126.67|585,144.58|610,162.5|635,180.42|660,198.33|685,216.25|710,234.17|735,252.08|760,270" | split: "|" %}
{% assign strip_gable = "350,190|368.3,167.5|386.7,145|405,122.5|423.3,100|441.7,77.5|460,55|478.3,77.5|496.7,100|515,122.5|533.3,145|551.7,167.5|570,190" | split: "|" %}
{% assign strip_garage = "580,270|604.3,270|628.6,270|652.9,270|677.1,270|701.4,270|725.7,270|750,270" | split: "|" %}
{% assign gable_offset = strip_main.size %}
{% assign garage_offset = strip_main.size | plus: strip_gable.size %}

<section class="kw-scope kw-section{% if section.settings.raised %} kw-section--raised{% endif %}" id="kw-app-{{ section.id }}">
  <div class="kw-blueprint"></div>
  <div class="kw-wrap kws__inner">
    <div class="kws__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="kw-eyebrow kw-reveal">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="kws__heading kw-reveal">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="kws__lede kw-reveal">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="kws__showcase">
      <div class="kws__phone kw-reveal-scale">
        <div class="kws-phone">
          <div class="kws-phone__bar">
            <span class="kws-phone__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
            </span>
            <span class="kws-phone__brand">Kilowash Control</span>
            <span class="kws-phone__status" aria-hidden="true"></span>
          </div>
          <div class="kws-phone__screen">
            <p class="kws-phone__label">Choose a scene</p>
            <div class="kws-scene-grid" data-kws-scenes>
              <button type="button" class="kws-scene is-active" data-kws-scene="gold" aria-pressed="true" style="--sw: var(--kws-gold);">
                <span class="kws-scene__icon"></span>
                <span>Solid Gold</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="ruby" aria-pressed="false" style="--sw: var(--kws-ruby);">
                <span class="kws-scene__icon"></span>
                <span>Ruby Red</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="ice" aria-pressed="false" style="--sw: var(--kws-ice);">
                <span class="kws-scene__icon"></span>
                <span>Ice Blue</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="emerald" aria-pressed="false" style="--sw: var(--kws-emerald);">
                <span class="kws-scene__icon"></span>
                <span>Emerald Green</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="sunset" aria-pressed="false" style="--sw: var(--kws-sunset);">
                <span class="kws-scene__icon"></span>
                <span>Sunset Orange</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="teal" aria-pressed="false" style="--sw: var(--kws-teal);">
                <span class="kws-scene__icon"></span>
                <span>Teal Glow</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="violet" aria-pressed="false" style="--sw: var(--kws-violet);">
                <span class="kws-scene__icon"></span>
                <span>Violet Party</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="holiday" aria-pressed="false" style="--sw: var(--kws-red);">
                <span class="kws-scene__icon kws-scene__icon--split"></span>
                <span>Holiday Classic</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="gameday" aria-pressed="false" style="--sw: var(--kws-blue);">
                <span class="kws-scene__icon kws-scene__icon--split2"></span>
                <span>Game Day</span>
              </button>
              <button type="button" class="kws-scene" data-kws-scene="rainbow" aria-pressed="false" style="--sw: conic-gradient(from 0deg, #ff5f6d, #ffc371, #7bed9f, #70a1ff, #a55eea, #ff5f6d);">
                <span class="kws-scene__icon"></span>
                <span>16M Colors</span>
              </button>
            </div>
            <button type="button" class="kws-apply kw-btn" data-kws-apply>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
              Apply to home
            </button>
          </div>
        </div>
      </div>

      <div class="kws__house">
        <div class="kws-house-glow" aria-hidden="true"></div>
        <div class="kws-vshape" style="clip-path: polygon(12.195% 46%, 56.098% 11%, 56.098% 46%); background: #12161c;"></div>
        <div class="kws-vshape" style="clip-path: polygon(56.098% 11%, 92.683% 54%, 56.098% 54%); background: #12161c;"></div>
        <div class="kws-vshape" style="clip-path: polygon(13.415% 45%, 24.39% 28%, 35.366% 45%); background: #12161c;"></div>
        <div class="kws-vshape" style="clip-path: polygon(28.049% 41%, 40.244% 18%, 52.439% 41%); background: #12161c;"></div>
        <div class="kws-vshape" style="clip-path: polygon(42.683% 37%, 56.098% 12%, 69.512% 37%); background: #12161c;"></div>
        <div class="kws-vshape" style="clip-path: polygon(36.585% 88%, 42.683% 88%, 44.512% 92%, 34.756% 92%); background: #3a4149;"></div>
        <svg class="kws-house" data-kws-house data-scene="gold" viewBox="0 0 820 500" role="img" aria-label="Flat vector illustration of a multi-gable house with three animated color-changing light strips">
          <ellipse cx="420" cy="478" rx="360" ry="14" fill="rgba(0,0,0,0.35)" />

          <!-- walls -->
          <rect x="100" y="230" width="360" height="230" fill="#2e343d" />
          <rect x="460" y="270" width="300" height="190" fill="#2e343d" />
          <rect x="95" y="459" width="670" height="13" fill="#232a33" />

          <!-- main roof outline (fill handled by .kws-vshape divs behind this svg) -->
          <polyline points="100,230 460,55 760,270" fill="none" stroke="#3a4656" stroke-width="3" />

          <!-- gable A (small, front-left) -->
          <polyline points="110,225 200,140 290,225" fill="none" stroke="#4a5563" stroke-width="2" />
          <line x1="200" y1="150" x2="150" y2="200" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <line x1="200" y1="150" x2="175" y2="212" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <line x1="200" y1="150" x2="250" y2="200" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <line x1="200" y1="150" x2="225" y2="212" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <circle class="kws-window" cx="200" cy="216" r="16" fill="#f0d9a0" opacity="0.7" stroke="#4a5563" stroke-width="3" />

          <!-- gable B (medium, middle) -->
          <polyline points="230,205 330,90 430,205" fill="none" stroke="#4a5563" stroke-width="2" />
          <line x1="330" y1="100" x2="270" y2="165" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <line x1="330" y1="100" x2="300" y2="180" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <line x1="330" y1="100" x2="390" y2="165" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <line x1="330" y1="100" x2="360" y2="180" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <rect class="kws-window" x="300" y="140" width="60" height="60" fill="#f0d9a0" opacity="0.65" stroke="#4a5563" stroke-width="3" />
          <line x1="330" y1="140" x2="330" y2="200" stroke="#4a5563" stroke-width="2" />
          <line x1="300" y1="170" x2="360" y2="170" stroke="#4a5563" stroke-width="2" />

          <!-- gable C (tall, right) -->
          <polyline points="350,185 460,60 570,185" fill="none" stroke="#4a5563" stroke-width="2" />
          <line x1="460" y1="70" x2="395" y2="140" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <line x1="460" y1="70" x2="425" y2="155" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <line x1="460" y1="70" x2="525" y2="140" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <line x1="460" y1="70" x2="495" y2="155" stroke="#c9c3b4" stroke-width="2" opacity="0.85" />
          <rect class="kws-window" x="429" y="95" width="62" height="72" fill="#f0d9a0" opacity="0.65" stroke="#4a5563" stroke-width="3" />
          <line x1="460" y1="95" x2="460" y2="167" stroke="#4a5563" stroke-width="2" />
          <line x1="429" y1="131" x2="491" y2="131" stroke="#4a5563" stroke-width="2" />

          <!-- large picture window with shine -->
          <rect x="140" y="300" width="115" height="140" fill="#1a1f26" stroke="#4a5563" stroke-width="4" />
          <rect class="kws-window" x="148" y="308" width="99" height="124" fill="#f0d9a0" opacity="0.55" />
          <line x1="197" y1="308" x2="197" y2="432" stroke="#4a5563" stroke-width="2" />
          <line x1="148" y1="370" x2="247" y2="370" stroke="#4a5563" stroke-width="2" />
          <line x1="158" y1="420" x2="200" y2="316" stroke="rgba(255,255,255,0.18)" stroke-width="6" />
          <line x1="185" y1="424" x2="230" y2="316" stroke="rgba(255,255,255,0.14)" stroke-width="6" />

          <!-- door -->
          <rect x="290" y="340" width="70" height="100" fill="#1a1f26" stroke="#4a5563" stroke-width="4" />
          <line x1="325" y1="340" x2="325" y2="440" stroke="#3a424c" stroke-width="2" />
          <circle cx="343" cy="392" r="3" fill="#f5b942" />

          <!-- small window near garage roofline -->
          <rect x="610" y="285" width="42" height="42" fill="#1a1f26" stroke="#4a5563" stroke-width="3" />
          <rect class="kws-window" x="616" y="291" width="30" height="30" fill="#f0d9a0" opacity="0.5" />

          <!-- garage -->
          <rect x="560" y="330" width="180" height="115" fill="#12161c" stroke="#4a5563" stroke-width="3" />
          <line x1="560" y1="354" x2="740" y2="354" stroke="#2e343d" stroke-width="2" />
          <line x1="560" y1="378" x2="740" y2="378" stroke="#2e343d" stroke-width="2" />
          <line x1="560" y1="402" x2="740" y2="402" stroke="#2e343d" stroke-width="2" />
          <line x1="560" y1="426" x2="740" y2="426" stroke="#2e343d" stroke-width="2" />

          <!-- landscaping -->
          <ellipse cx="80" cy="448" rx="42" ry="20" fill="#234a2e" />
          <ellipse cx="55" cy="452" rx="26" ry="14" fill="#2a5236" />
          <ellipse cx="700" cy="450" rx="36" ry="18" fill="#234a2e" />
          <rect x="778" y="410" width="9" height="52" fill="#332318" />
          <circle cx="782" cy="392" r="34" fill="#2a5236" />
          <circle cx="760" cy="410" r="24" fill="#234a2e" />
          <circle cx="804" cy="408" r="24" fill="#234a2e" />

          <!-- light strip: main roofline -->
          <polyline class="kws-wire" points="{{ strip_main | join: ' ' }}" fill="none" stroke="#0c0f13" stroke-width="2" />
          {% for point in strip_main %}
            {% assign coords = point | split: "," %}
            <circle class="kws-bulb" cx="{{ coords[0] }}" cy="{{ coords[1] }}" r="6.5" style="--i: {{ forloop.index0 }};"></circle>
          {% endfor %}

          <!-- light strip: gable C accent -->
          <polyline class="kws-wire" points="{{ strip_gable | join: ' ' }}" fill="none" stroke="#0c0f13" stroke-width="2" />
          {% for point in strip_gable %}
            {% assign coords = point | split: "," %}
            {% assign gi = forloop.index0 | plus: gable_offset %}
            <circle class="kws-bulb" cx="{{ coords[0] }}" cy="{{ coords[1] }}" r="6" style="--i: {{ gi }};"></circle>
          {% endfor %}

          <!-- light strip: garage accent -->
          <polyline class="kws-wire" points="{{ strip_garage | join: ' ' }}" fill="none" stroke="#0c0f13" stroke-width="1.5" />
          {% for point in strip_garage %}
            {% assign coords = point | split: "," %}
            {% assign bi = forloop.index0 | plus: garage_offset %}
            <circle class="kws-bulb" cx="{{ coords[0] }}" cy="{{ coords[1] }}" r="5.5" style="--i: {{ bi }};"></circle>
          {% endfor %}
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  #kw-app-{{ section.id }} {
    --kws-gold: var(--kw-gold);
    --kws-teal: var(--kw-teal);
    --kws-violet: var(--kw-violet);
    --kws-red: #e5484d;
    --kws-green: #2f9e5c;
    --kws-blue: #3b82f6;
    --kws-white: #f5f5f0;
    --kws-ruby: #b91c3c;
    --kws-ice: #7dd3fc;
    --kws-emerald: #10b981;
    --kws-sunset: #fb923c;
    padding-block: clamp(56px, 8vw, 108px);
  }

  #kw-app-{{ section.id }} .kws__intro {
    max-width: 60ch;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  #kw-app-{{ section.id }} .kws__heading {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    max-width: 22ch;
    margin-block: 0.4em 0.5em;
  }

  #kw-app-{{ section.id }} .kws__lede {
    color: var(--kw-fg-dim);
    max-width: 52ch;
    line-height: 1.6;
  }

  #kw-app-{{ section.id }} .kws__showcase {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }

  @media (max-width: 900px) {
    #kw-app-{{ section.id }} .kws__showcase {
      grid-template-columns: 1fr;
    }
    #kw-app-{{ section.id }} .kws__house {
      order: -1;
    }
  }

  /* phone mockup */
  #kw-app-{{ section.id }} .kws-phone {
    background: linear-gradient(165deg, var(--kw-bg-raised), var(--kw-bg));
    border: 1px solid var(--kw-line-bright);
    border-radius: 32px;
    padding: 14px;
    max-width: 320px;
    margin-inline: auto;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  #kw-app-{{ section.id }} .kws-phone__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem 0.95rem;
    font-family: var(--kw-display);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--kw-fg-dim);
    text-transform: uppercase;
  }

  #kw-app-{{ section.id }} .kws-phone__mark {
    display: inline-flex;
    color: var(--kw-gold);
  }

  #kw-app-{{ section.id }} .kws-phone__brand {
    flex: 1;
  }

  #kw-app-{{ section.id }} .kws-phone__status {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--kw-teal);
    box-shadow: 0 0 6px var(--kw-teal);
  }

  #kw-app-{{ section.id }} .kws-phone__screen {
    background: var(--kw-bg);
    border-radius: 22px;
    padding: 1.1rem;
    border: 1px solid var(--kw-line);
  }

  #kw-app-{{ section.id }} .kws-phone__label {
    font-family: var(--kw-display);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--kw-fg-dim);
    margin: 0 0 0.9rem;
  }

  #kw-app-{{ section.id }} .kws-scene-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  #kw-app-{{ section.id }} .kws-scene {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.03), transparent), var(--kw-bg-raised);
    border: 1px solid var(--kw-line);
    border-radius: 14px;
    padding: 0.75rem 0.4rem 0.6rem;
    color: var(--kw-fg-dim);
    font-size: 0.7rem;
    font-family: var(--kw-body);
    cursor: pointer;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }

  #kw-app-{{ section.id }} .kws-scene:hover {
    transform: translateY(-2px);
    color: var(--kw-fg);
  }

  #kw-app-{{ section.id }} .kws-scene__icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sw, var(--kw-gold));
    box-shadow: 0 0 10px var(--sw, var(--kw-gold)), inset 0 1px 2px rgba(255, 255, 255, 0.5);
  }

  #kw-app-{{ section.id }} .kws-scene__icon--split {
    background: conic-gradient(var(--kws-red) 0deg 120deg, var(--kws-white) 120deg 240deg, var(--kws-green) 240deg 360deg);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.35);
  }

  #kw-app-{{ section.id }} .kws-scene__icon--split2 {
    background: conic-gradient(var(--kws-blue) 0deg 180deg, var(--kws-red) 180deg 360deg);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
  }

  #kw-app-{{ section.id }} .kws-scene.is-active {
    border-color: var(--kw-gold);
    color: var(--kw-fg);
    box-shadow: 0 0 0 1px var(--kw-gold), 0 0 18px rgba(245, 185, 66, 0.35);
  }

  #kw-app-{{ section.id }} .kws-apply {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    text-align: center;
    transition: box-shadow 0.3s ease, transform 0.15s ease;
  }

  #kw-app-{{ section.id }} .kws-apply.is-applied {
    animation: kws-apply-pulse 0.7s ease;
  }

  @keyframes kws-apply-pulse {
    0% { box-shadow: 0 0 0 0 rgba(245, 185, 66, 0.6); }
    70% { box-shadow: 0 0 0 16px rgba(245, 185, 66, 0); }
    100% { box-shadow: 0 0 0 0 rgba(245, 185, 66, 0); }
  }

  /* house */
  #kw-app-{{ section.id }} .kws__house {
    width: 100%;
    aspect-ratio: 820 / 500;
    position: relative;
  }

  #kw-app-{{ section.id }} .kws-house-glow {
    position: absolute;
    inset: -8% -4%;
    background: radial-gradient(ellipse 60% 55% at 50% 60%, rgba(0, 0, 0, 0.6), transparent 70%);
    filter: blur(30px);
    z-index: 0;
    pointer-events: none;
  }

  #kw-app-{{ section.id }} .kws-vshape {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #kw-app-{{ section.id }} .kws-house {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  #kw-app-{{ section.id }} .kws-window {
    filter: drop-shadow(0 0 6px rgba(240, 217, 160, 0.25));
  }

  #kw-app-{{ section.id }} .kws-bulb {
    filter: drop-shadow(0 0 9px rgba(255, 255, 255, 0.55));
    transform-box: fill-box;
    transform-origin: center;
  }

  /* base (no-motion-safe) fill + glow per scene */
  #kw-app-{{ section.id }} .kws-house[data-scene="gold"] .kws-bulb { fill: var(--kws-gold); filter: drop-shadow(0 0 13px var(--kws-gold)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="ruby"] .kws-bulb { fill: var(--kws-ruby); filter: drop-shadow(0 0 13px var(--kws-ruby)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="ice"] .kws-bulb { fill: var(--kws-ice); filter: drop-shadow(0 0 13px var(--kws-ice)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="emerald"] .kws-bulb { fill: var(--kws-emerald); filter: drop-shadow(0 0 13px var(--kws-emerald)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="sunset"] .kws-bulb { fill: var(--kws-sunset); filter: drop-shadow(0 0 13px var(--kws-sunset)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="teal"] .kws-bulb { fill: var(--kws-teal); filter: drop-shadow(0 0 13px var(--kws-teal)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="violet"] .kws-bulb { fill: var(--kws-violet); filter: drop-shadow(0 0 13px var(--kws-violet)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="holiday"] .kws-bulb { fill: var(--kws-red); }
  #kw-app-{{ section.id }} .kws-house[data-scene="gameday"] .kws-bulb { fill: var(--kws-blue); }
  #kw-app-{{ section.id }} .kws-house[data-scene="rainbow"] .kws-bulb { fill: hsl(calc(var(--i) * 7.83deg), 90%, 60%); }

  @media (prefers-reduced-motion: no-preference) {
    #kw-app-{{ section.id }} .kws-house[data-scene="gold"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="ruby"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="ice"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="emerald"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="sunset"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="teal"] .kws-bulb {
      animation: kws-twinkle 2.4s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.1s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="violet"] .kws-bulb {
      animation: kws-twinkle 1.5s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.08s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="holiday"] .kws-bulb {
      animation: kws-holiday-chase 1.8s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.12s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="gameday"] .kws-bulb {
      animation: kws-gameday-chase 1.1s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.08s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="rainbow"] .kws-bulb {
      animation: kws-rainbow-cycle 4s linear infinite;
      animation-delay: calc(var(--i) * -0.12s);
    }
  }

  @keyframes kws-twinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.82); }
  }

  @keyframes kws-holiday-chase {
    0%, 32% { fill: var(--kws-red); }
    33%, 65% { fill: var(--kws-white); }
    66%, 100% { fill: var(--kws-green); }
  }

  @keyframes kws-gameday-chase {
    0%, 49% { fill: var(--kws-blue); }
    50%, 100% { fill: var(--kws-red); }
  }

  @keyframes kws-rainbow-cycle {
    from { filter: hue-rotate(0deg) drop-shadow(0 0 9px rgba(255, 255, 255, 0.55)); }
    to { filter: hue-rotate(360deg) drop-shadow(0 0 9px rgba(255, 255, 255, 0.55)); }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('kw-app-{{ section.id }}');
    if (!root) return;

    var house = root.querySelector('[data-kws-house]');
    var buttons = root.querySelectorAll('[data-kws-scene]');
    var applyBtn = root.querySelector('[data-kws-apply]');
    var order = ['gold', 'ruby', 'ice', 'emerald', 'sunset', 'teal', 'violet', 'holiday', 'gameday', 'rainbow'];
    var index = 0;
    var timer = null;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setScene(scene) {
      house.setAttribute('data-scene', scene);
      buttons.forEach(function (btn) {
        var active = btn.dataset.kwsScene === scene;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      index = order.indexOf(scene);
      if (index === -1) index = 0;
    }

    function advance() {
      index = (index + 1) % order.length;
      setScene(order[index]);
    }

    function startAutoplay() {
      if (reduceMotion) return;
      stopAutoplay();
      timer = window.setInterval(advance, 4500);
    }

    function stopAutoplay() {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        setScene(btn.dataset.kwsScene);
        startAutoplay();
      });
    });

    if (applyBtn) {
      applyBtn.addEventListener('click', function () {
        applyBtn.classList.remove('is-applied');
        void applyBtn.offsetWidth;
        applyBtn.classList.add('is-applied');
        window.setTimeout(function () { applyBtn.classList.remove('is-applied'); }, 800);
      });
    }

    setScene('gold');
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "KW App showcase",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "One app. Every color." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "16 million colors, controlled from your pocket." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick a preset scene or build your own — tap Apply and your roofline updates in real time." }
  ],
  "presets": [{ "name": "KW App showcase" }]
}
{% endschema %}
