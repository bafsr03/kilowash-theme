  /* house */
  #kw-app-{{ section.id }} .kws__house {
    width: 100%;
    position: relative;
  }

  #kw-app-{{ section.id }} .kws-house-glow {
    position: absolute;
    inset: -8% -4%;
    background: radial-gradient(ellipse 60% 55% at 50% 60%, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.38) 30%, rgba(0, 0, 0, 0.16) 55%, transparent 75%);
    z-index: 0;
    pointer-events: none;
  }

  #kw-app-{{ section.id }} .kws-house {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  #kw-app-{{ section.id }} .kws-window {
    filter: drop-shadow(0 0 6px rgba(240, 217, 160, 0.25));
  }

  #kw-app-{{ section.id }} .kws-bulb {
    filter: drop-shadow(0 0 9px rgba(255, 255, 255, 0.55));
    transform-box: fill-box;
    transform-origin: center;
  }

  /* base (no-motion-safe) fill + glow per scene */
  #kw-app-{{ section.id }} .kws-house[data-scene="gold"] .kws-bulb { fill: var(--kws-gold); filter: drop-shadow(0 0 13px var(--kws-gold)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="ruby"] .kws-bulb { fill: var(--kws-ruby); filter: drop-shadow(0 0 13px var(--kws-ruby)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="ice"] .kws-bulb { fill: var(--kws-ice); filter: drop-shadow(0 0 13px var(--kws-ice)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="emerald"] .kws-bulb { fill: var(--kws-emerald); filter: drop-shadow(0 0 13px var(--kws-emerald)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="sunset"] .kws-bulb { fill: var(--kws-sunset); filter: drop-shadow(0 0 13px var(--kws-sunset)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="teal"] .kws-bulb { fill: var(--kws-teal); filter: drop-shadow(0 0 13px var(--kws-teal)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="violet"] .kws-bulb { fill: var(--kws-violet); filter: drop-shadow(0 0 13px var(--kws-violet)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.6)); }
  #kw-app-{{ section.id }} .kws-house[data-scene="holiday"] .kws-bulb { fill: var(--kws-red); }
  #kw-app-{{ section.id }} .kws-house[data-scene="gameday"] .kws-bulb { fill: var(--kws-blue); }
  #kw-app-{{ section.id }} .kws-house[data-scene="rainbow"] .kws-bulb { fill: hsl(calc(var(--i) * 7.83deg), 90%, 60%); }
  #kw-app-{{ section.id }} .kws-house[data-scene="america"] .kws-bulb { fill: var(--kws-red); }
  #kw-app-{{ section.id }} .kws-house[data-scene="halloween"] .kws-bulb { fill: var(--kws-sunset); }
  #kw-app-{{ section.id }} .kws-house[data-scene="easter"] .kws-bulb { fill: var(--kws-pastel-pink); }
  #kw-app-{{ section.id }} .kws-house[data-scene="birthday"] .kws-bulb { fill: var(--kws-party-pink); }

  @media (prefers-reduced-motion: no-preference) {
    #kw-app-{{ section.id }} .kws-house[data-scene="gold"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="ruby"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="ice"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="emerald"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="sunset"] .kws-bulb,
    #kw-app-{{ section.id }} .kws-house[data-scene="teal"] .kws-bulb {
      animation: kws-twinkle 2.4s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.1s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="violet"] .kws-bulb {
      animation: kws-twinkle 1.5s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.08s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="holiday"] .kws-bulb {
      animation: kws-holiday-chase 1.8s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.12s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="gameday"] .kws-bulb {
      animation: kws-gameday-chase 1.1s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.08s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="rainbow"] .kws-bulb {
      animation: kws-rainbow-cycle 4s linear infinite;
      animation-delay: calc(var(--i) * -0.12s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="america"] .kws-bulb {
      animation: kws-america-chase 1.8s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.12s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="halloween"] .kws-bulb {
      animation: kws-halloween-chase 1.3s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.09s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="easter"] .kws-bulb {
      animation: kws-easter-chase 2.4s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.14s);
    }
    #kw-app-{{ section.id }} .kws-house[data-scene="birthday"] .kws-bulb {
      animation: kws-birthday-chase 1.6s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.1s);
    }
  }

  @keyframes kws-twinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.82); }
  }

  @keyframes kws-holiday-chase {
    0%, 32% { fill: var(--kws-red); }
    33%, 65% { fill: var(--kws-white); }
    66%, 100% { fill: var(--kws-green); }
  }

  @keyframes kws-gameday-chase {
    0%, 49% { fill: var(--kws-blue); }
    50%, 100% { fill: var(--kws-red); }
  }

  @keyframes kws-rainbow-cycle {
    from { filter: hue-rotate(0deg) drop-shadow(0 0 9px rgba(255, 255, 255, 0.55)); }
    to { filter: hue-rotate(360deg) drop-shadow(0 0 9px rgba(255, 255, 255, 0.55)); }
  }

  @keyframes kws-america-chase {
    0%, 32% { fill: var(--kws-red); }
    33%, 65% { fill: var(--kws-white); }
    66%, 100% { fill: var(--kws-blue); }
  }

  @keyframes kws-halloween-chase {
    0%, 49% { fill: var(--kws-sunset); }
    50%, 100% { fill: var(--kws-violet); }
  }

  @keyframes kws-easter-chase {
    0%, 24% { fill: var(--kws-pastel-pink); }
    25%, 49% { fill: var(--kws-pastel-lavender); }
    50%, 74% { fill: var(--kws-pastel-mint); }
    75%, 100% { fill: var(--kws-pastel-yellow); }
  }

  @keyframes kws-birthday-chase {
    0%, 24% { fill: var(--kws-party-pink); }
    25%, 49% { fill: var(--kws-party-cyan); }
    50%, 74% { fill: var(--kws-gold); }
    75%, 100% { fill: var(--kws-violet); }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('kw-app-{{ section.id }}');
    if (!root) return;

    var house = root.querySelector('[data-kws-house]');
    var buttons = root.querySelectorAll('[data-kws-scene]');
    var applyBtn = root.querySelector('[data-kws-apply]');
    var nameEl = root.querySelector('[data-kws-scene-name]');
    var order = ['gold', 'ruby', 'ice', 'emerald', 'sunset', 'teal', 'violet', 'holiday', 'gameday', 'rainbow', 'america', 'halloween', 'easter', 'birthday'];
    var index = 0;
    var timer = null;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setScene(scene) {
      house.setAttribute('data-scene', scene);
      buttons.forEach(function (btn) {
        var active = btn.dataset.kwsScene === scene;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        if (active && nameEl) nameEl.textContent = btn.getAttribute('aria-label') || '';
      });
      index = order.indexOf(scene);
      if (index === -1) index = 0;
    }

    function advance() {
      index = (index + 1) % order.length;
      setScene(order[index]);
    }

    function startAutoplay() {
      if (reduceMotion) return;
      stopAutoplay();
      timer = window.setInterval(advance, 4500);
    }

    function stopAutoplay() {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        setScene(btn.dataset.kwsScene);
        startAutoplay();
      });
    });

    if (applyBtn) {
      applyBtn.addEventListener('click', function () {
        applyBtn.classList.remove('is-applied');
        void applyBtn.offsetWidth;
        applyBtn.classList.add('is-applied');
        window.setTimeout(function () { applyBtn.classList.remove('is-applied'); }, 800);
      });
    }

    setScene('gold');
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "KW App showcase",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "One app. Every color." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "16 million colors, controlled from your pocket." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick a preset scene or build your own — tap Apply and your roofline updates in real time." }
  ],
  "presets": [{ "name": "KW App showcase" }]
}
{% endschema %}
