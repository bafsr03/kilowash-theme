{%- comment -%}
  LocalBusiness (HomeAndConstructionBusiness) JSON-LD for Kilowash.

  Modeled as a SERVICE-AREA business: Kilowash travels to the customer and does not
  serve anyone at a shop address, so `areaServed` is supplied and `address` is
  deliberately reduced to region only. `address` stays the single home region the
  Google Business Profile is registered under; the multi-state footprint lives in
  `areaServed` (see kw-schema-areaserved) and must not be smeared into the address. Google treats a missing streetAddress as
  correct for this business type — inventing one would create a NAP mismatch with
  the Google Business Profile.

  Deliberate omission: no `aggregateRating` / `review`. Google's structured data
  policy forbids self-serving review markup on LocalBusiness and Organization
  (reviews about the business, collected by the business). Marking up the 5.0/30
  Google rating here is a manual-action risk, not a rich-result win. Review markup
  belongs only on third-party-collected reviews, which these are not.

  The visible phone/email stay cloaked by kw-phone-link / kw-email-link so scrapers
  can't harvest them. Putting the real number here gives Google clean NAP data
  without un-cloaking anything in the rendered copy.

  Rendered once, sitewide, from layout/theme.liquid.
{%- endcomment -%}

{%- liquid
  assign biz_name = settings.kw_seo_business_name | default: shop.name
  assign biz_phone = settings.kw_seo_phone
  assign biz_email = settings.kw_seo_email
  assign biz_region = settings.kw_seo_region | default: 'UT'
  assign biz_locality = settings.kw_seo_locality
  assign price_range = settings.kw_seo_price_range

  assign same_as_list = ''
  if settings.kw_seo_instagram != blank
    assign same_as_list = same_as_list | append: settings.kw_seo_instagram | append: ','
  endif
  if settings.kw_seo_facebook != blank
    assign same_as_list = same_as_list | append: settings.kw_seo_facebook | append: ','
  endif
  if settings.kw_seo_gbp_url != blank
    assign same_as_list = same_as_list | append: settings.kw_seo_gbp_url | append: ','
  endif
  if settings.kw_bbb_profile_url != blank
    assign same_as_list = same_as_list | append: settings.kw_bbb_profile_url | append: ','
  endif
  assign same_as = same_as_list | split: ','

  assign hours_raw = settings.kw_seo_hours
  assign hours_list = hours_raw | split: ','
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HomeAndConstructionBusiness",
    "@id": {{ request.origin | append: '/#business' | json }},
    "name": {{ biz_name | json }},
    "url": {{ request.origin | json }},
    {% if settings.logo != blank -%}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }},
    {%- endif %}
    {% if settings.kw_seo_share_image != blank -%}
      "image": {{ settings.kw_seo_share_image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- elsif settings.logo != blank -%}
      "image": {{ settings.logo | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif %}
    {% if settings.kw_seo_description != blank -%}
      "description": {{ settings.kw_seo_description | json }},
    {%- endif %}
    {% if biz_phone != blank -%}
      "telephone": {{ biz_phone | json }},
    {%- endif %}
    {% if biz_email != blank -%}
      "email": {{ biz_email | json }},
    {%- endif %}
    {% if price_range != blank -%}
      "priceRange": {{ price_range | json }},
    {%- endif %}
    "address": {
      "@type": "PostalAddress",
      {% if biz_locality != blank -%}
        "addressLocality": {{ biz_locality | json }},
      {%- endif %}
      "addressRegion": {{ biz_region | json }},
      "addressCountry": "US"
    },
    "areaServed": {% render 'kw-schema-areaserved' %},
    {% if hours_list.size > 0 -%}
      "openingHoursSpecification": [
        {%- for spec in hours_list -%}
          {%- assign parts = spec | strip | split: ' ' -%}
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": {{ parts[0] | json }},
            "opens": {{ parts[1] | json }},
            "closes": {{ parts[2] | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
    {%- endif %}
    {% if same_as.size > 0 -%}
      "sameAs": [
        {%- for link in same_as -%}
          {{ link | strip | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
    {%- endif %}
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": {{ biz_name | append: ' services' | json }},
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Permanent architectural lighting installation",
            "url": {{ request.origin | append: '/pages/lighting' | json }}
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Solar attic fan installation",
            "url": {{ request.origin | append: '/pages/solar' | json }}
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Solar panel cleaning and maintenance",
            "url": {{ request.origin | append: '/pages/solar' | json }}
          }
        }
      ]
    }
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": {{ request.origin | append: '/#website' | json }},
    "url": {{ request.origin | json }},
    "name": {{ biz_name | json }},
    "publisher": { "@id": {{ request.origin | append: '/#business' | json }} }
  }
</script>
