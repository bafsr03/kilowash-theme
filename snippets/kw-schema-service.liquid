{%- comment -%}
  Service JSON-LD for the service pages. Template-gated, so every other template
  renders nothing.

  Each service line gets its own node rather than one blurred "solar" entry: Critter
  Guard and panel cleaning answer completely different searches from attic fans, and
  they now have their own pages to match.

  `provider` points at the @id of the HomeAndConstructionBusiness node emitted by
  kw-schema-business.liquid, so Google resolves one business entity across the
  whole site instead of several unlinked ones.
{%- endcomment -%}

{%- liquid
  assign svc_name = ''
  assign svc_type = ''
  assign svc_desc = ''

  case template.suffix
    when 'lighting'
      assign svc_name = 'Permanent Architectural Lighting Installation'
      assign svc_type = 'Permanent holiday and architectural lighting installation'
      assign svc_desc = 'Professionally installed, app-controlled permanent architectural lighting. Track is mounted flush to the roofline and rated for freeze-thaw winters and snow load, with a 10-year warranty.'
    when 'solar'
      assign svc_name = 'Solar Attic Fan Installation and Solar Panel Care'
      assign svc_type = 'Solar attic fan installation, solar panel cleaning and maintenance'
      assign svc_desc = 'Solar attic fan installation to pull trapped heat out of the attic, plus solar panel cleaning and maintenance for existing rooftop systems.'
    when 'critter-guard'
      assign svc_name = 'Critter Guard Solar Panel Bird and Pest Exclusion'
      assign svc_type = 'Solar panel bird guard and pest exclusion installation'
      assign svc_desc = 'Rigid mesh exclusion barrier clipped to the perimeter of an existing solar array to keep birds, pigeons and rodents from nesting underneath. No roof penetration and no change to the panel warranty.'
    when 'panel-cleaning'
      assign svc_name = 'Solar Panel Cleaning and System Care'
      assign svc_type = 'Solar panel cleaning, maintenance, repair and removal-reinstall'
      assign svc_desc = 'Cleaning, servicing and removal-and-reinstall for existing rooftop solar arrays, including panel removal for roof replacement. Non-abrasive methods that protect the anti-reflective coating on the panel glass.'
    when 'mid-ohio-valley'
      assign svc_name = 'Permanent Lighting and Solar Attic Fans, Mid-Ohio Valley'
      assign svc_type = 'Permanent holiday and architectural lighting installation, solar attic fan installation'
      assign svc_desc = 'App-controlled permanent architectural lighting and solar attic fan installation for homes in Washington, Noble and Morgan County, Ohio and Wood County, West Virginia.'
    when 'city'
      assign svc_name = 'Permanent Architectural Lighting Installation'
      assign svc_type = 'Permanent holiday and architectural lighting installation'
      assign svc_desc = 'Professionally installed, app-controlled permanent architectural lighting for homes, mounted flush to the roofline and rated for freeze-thaw winters.'
  endcase

-%}

{%- if svc_name != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": {{ svc_name | json }},
      "serviceType": {{ svc_type | json }},
      "description": {{ svc_desc | json }},
      "url": {{ canonical_url | json }},
      "provider": { "@id": {{ request.origin | append: '/#business' | json }} },
      {%- if template.suffix == 'mid-ohio-valley' -%}
        {%- comment -%}
          The Mid-Ohio Valley page offers the service in markets 2 and 3 only, so its
          Service node names those places rather than the whole three-state footprint.
          Same positional lists and County-vs-City typing as kw-schema-areaserved.
        {%- endcomment -%}
        {%- assign mov_states = settings.kw_seo_states_served | split: ',' -%}
        {%- assign mov_sep = '' -%}
        "areaServed": [
          {%- for state in mov_states -%}
            {%- if forloop.index == 1 -%}{%- continue -%}{%- endif -%}
            {%- assign state_name = state | strip -%}
            {%- if forloop.index == 2 -%}
              {%- assign mov_places = settings.kw_seo_areas_served_2 | split: ',' -%}
            {%- else -%}
              {%- assign mov_places = settings.kw_seo_areas_served_3 | split: ',' -%}
            {%- endif -%}
            {%- for place in mov_places -%}
              {%- assign place_name = place | strip -%}
              {%- if place_name != blank -%}
                {%- assign place_type = 'City' -%}
                {%- if place_name contains 'County' -%}{%- assign place_type = 'AdministrativeArea' -%}{%- endif -%}
                {{ mov_sep }}{ "@type": {{ place_type | json }}, "name": {{ place_name | json }}, "containedInPlace": { "@type": "State", "name": {{ state_name | json }} } }
                {%- assign mov_sep = ',' -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        ]
      {%- else -%}
        "areaServed": {% render 'kw-schema-areaserved' %}
      {%- endif %}
    }
  </script>
{%- endif -%}
