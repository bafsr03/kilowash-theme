{% comment %}
  Floating smart-light color control. A working demo of the "full smart
  color control" pitch — picking a swatch re-lights the whole site's
  accent color (buttons, labels, readouts), the same way the app controls
  a customer's actual fixtures. Persisted via localStorage.
{% endcomment %}
<div class="kw-scope" id="kw-lightswitch">
  <div class="kw-ls-flash" id="kw-ls-flash"></div>
  <button type="button" class="kw-ls-toggle" id="kw-ls-toggle" aria-expanded="false" aria-controls="kw-ls-panel" aria-label="Try smart light color control">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.4 10.9c.5.4.9 1 .9 1.6V16h5v-.5c0-.6.3-1.2.9-1.6A6 6 0 0 0 12 3Z"/>
    </svg>
  </button>
  <div class="kw-ls-panel" id="kw-ls-panel">
    <span class="kw-ls-label">Try smart control</span>
    <div class="kw-ls-swatches" role="group" aria-label="Accent color">
      <button type="button" class="kw-ls-swatch" data-kw-ls-color="#f5b942" style="background:#f5b942" aria-pressed="true" aria-label="Warm gold"></button>
      <button type="button" class="kw-ls-swatch" data-kw-ls-color="#29d9c2" style="background:#29d9c2" aria-pressed="false" aria-label="Electric teal"></button>
      <button type="button" class="kw-ls-swatch" data-kw-ls-color="#ff4d5e" style="background:#ff4d5e" aria-pressed="false" aria-label="Ruby red"></button>
      <button type="button" class="kw-ls-swatch" data-kw-ls-color="#3ddc84" style="background:#3ddc84" aria-pressed="false" aria-label="Emerald green"></button>
      <button type="button" class="kw-ls-swatch" data-kw-ls-color="#c14bff" style="background:#c14bff" aria-pressed="false" aria-label="Royal violet"></button>
    </div>
    <div class="kw-ls-divider"></div>
    <a href="tel:3854062335" class="kw-ls-contact">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
      Call / Text 385-406-2335
    </a>
  </div>
</div>
